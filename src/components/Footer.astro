---
import type { HTMLAttributes } from "astro/types";
import { useTranslations } from "@/i18n";

type Props = {
  noMarginTop?: boolean;
} & HTMLAttributes<"footer">;

const { noMarginTop = false, class: className, ...attrs } = Astro.props;

const t = useTranslations(Astro.currentLocale);
const currentYear = new Date().getFullYear();
---

<footer
  class:list={["app-layout", { "mt-auto": !noMarginTop }, className]}
  {...attrs}
>
  <div
    class="border-border flex items-center justify-center border-t py-6 sm:py-4"
  >
    <div class="my-2 flex flex-col items-center gap-3 sm:flex-row sm:gap-5">
      <nav class="flex flex-wrap justify-center gap-x-4 gap-y-1 text-xs text-skin-base/70" aria-label="Footer navigation">
        <a href="/about" class="hover:text-skin-accent">About</a>
        <a href="/contact" class="hover:text-skin-accent">Contact</a>
        <a href="/privacy" class="hover:text-skin-accent">Privacy</a>
        <a href="/disclaimer" class="hover:text-skin-accent">Disclaimer</a>
      </nav>
      <span class="hidden sm:inline">|</span>
      <span>{t.footer.copyright} &#169; {currentYear}</span>
      <span>{t.footer.allRightsReserved}</span>
    </div>
  </div>
</footer>
