---
import type { HTMLAttributes } from "astro/types";
import { useTranslations } from "@/i18n";

type Props = {
  noMarginTop?: boolean;
} & HTMLAttributes<"footer">;

const { noMarginTop = false, class: className, ...attrs } = Astro.props;

const t = useTranslations(Astro.currentLocale);
const currentYear = new Date().getFullYear();
---

<footer
  class:list={["app-layout", { "mt-auto": !noMarginTop }, className]}
  {...attrs}
>
  <div
    class="border-border flex items-center justify-center border-t py-6 sm:py-5"
  >
    <div class="flex w-full flex-col items-center gap-3 text-center">
      <nav class="flex flex-wrap justify-center gap-x-5 gap-y-2 text-xs text-skin-base/70" aria-label="Footer navigation">
        <a href="/about" class="hover:text-skin-accent">About</a>
        <a href="/contact" class="hover:text-skin-accent">Contact</a>
        <a href="/privacy" class="hover:text-skin-accent">Privacy</a>
        <a href="/disclaimer" class="hover:text-skin-accent">Disclaimer</a>
        <a href="/terms" class="hover:text-skin-accent">Terms</a>
        <a href="/editorial-policy" class="hover:text-skin-accent">Editorial Policy</a>
      </nav>
      <div class="flex flex-wrap justify-center gap-x-2 text-xs text-skin-base/65">
        <span>{t.footer.copyright} &#169; {currentYear}</span>
        <span aria-hidden="true">·</span>
        <span>{t.footer.allRightsReserved}</span>
      </div>
    </div>
  </div>
</footer>
