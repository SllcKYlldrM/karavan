<section class="rounded-2xl border border-skin-line bg-skin-card p-5 shadow-sm sm:p-7" data-bilge-calculator>
  <div class="mb-6 max-w-2xl"><p class="mb-2 text-xs font-bold uppercase tracking-[0.18em] text-skin-accent">Marine safety planning calculator</p><h2 class="text-2xl font-bold tracking-tight text-skin-base sm:text-3xl">Bilge pump and emergency battery sizing</h2><p class="mt-3 text-sm leading-6 text-skin-base/75">Estimate derated pumping flow, pump current and battery runtime for a defined emergency planning interval.</p></div>
  <div class="grid gap-8 lg:grid-cols-[1fr_0.85fr]"><div class="grid gap-4 sm:grid-cols-2">
    <label class="text-xs font-semibold text-skin-base/75">Pump rated flow (L/min)<input type="number" min="0" value="100" data-setting="pumpRatedFlowLitresPerMinute" class="mt-1.5 w-full rounded-lg border border-skin-line bg-skin-card px-3 py-2.5 text-sm text-skin-base" /></label>
    <label class="text-xs font-semibold text-skin-base/75">Flow derating for head (%)<input type="number" min="0" max="90" value="35" data-setting="flowDeratingPercent" class="mt-1.5 w-full rounded-lg border border-skin-line bg-skin-card px-3 py-2.5 text-sm text-skin-base" /></label>
    <label class="text-xs font-semibold text-skin-base/75">Number of pumps<input type="number" min="1" step="1" value="1" data-setting="pumpCount" class="mt-1.5 w-full rounded-lg border border-skin-line bg-skin-card px-3 py-2.5 text-sm text-skin-base" /></label>
    <label class="text-xs font-semibold text-skin-base/75">Current per pump (A)<input type="number" min="0" value="8" data-setting="pumpCurrentAmps" class="mt-1.5 w-full rounded-lg border border-skin-line bg-skin-card px-3 py-2.5 text-sm text-skin-base" /></label>
    <label class="text-xs font-semibold text-skin-base/75">Battery capacity (Ah)<input type="number" min="0" value="200" data-setting="batteryCapacityAh" class="mt-1.5 w-full rounded-lg border border-skin-line bg-skin-card px-3 py-2.5 text-sm text-skin-base" /></label>
    <label class="text-xs font-semibold text-skin-base/75">Usable battery discharge<input type="number" min="0.01" max="1" step="0.05" value="0.8" data-setting="batteryUsableDepth" class="mt-1.5 w-full rounded-lg border border-skin-line bg-skin-card px-3 py-2.5 text-sm text-skin-base" /></label>
    <label class="text-xs font-semibold text-skin-base/75">Battery voltage (V)<input type="number" min="0.1" value="12" data-setting="batteryVoltage" class="mt-1.5 w-full rounded-lg border border-skin-line bg-skin-card px-3 py-2.5 text-sm text-skin-base" /></label>
    <label class="text-xs font-semibold text-skin-base/75">Emergency interval (hours)<input type="number" min="0" step="0.5" value="4" data-setting="emergencyDurationHours" class="mt-1.5 w-full rounded-lg border border-skin-line bg-skin-card px-3 py-2.5 text-sm text-skin-base" /></label>
  </div><div class="space-y-4"><h3 class="text-lg font-bold text-skin-base">Emergency estimate</h3><div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-1 xl:grid-cols-2"><div class="rounded-xl border border-skin-line bg-skin-fill p-4"><p class="text-xs text-skin-base/65">Effective flow</p><strong class="mt-1 block text-2xl text-skin-base" data-result="effectiveFlowLitresPerMinute">—</strong></div><div class="rounded-xl border border-skin-line bg-skin-fill p-4"><p class="text-xs text-skin-base/65">Total pump current</p><strong class="mt-1 block text-2xl text-skin-base" data-result="totalCurrentAmps">—</strong></div><div class="rounded-xl border border-skin-line bg-skin-fill p-4"><p class="text-xs text-skin-base/65">Battery runtime</p><strong class="mt-1 block text-2xl text-skin-base" data-result="batteryRuntimeHours">—</strong></div><div class="rounded-xl border border-skin-line bg-skin-fill p-4"><p class="text-xs text-skin-base/65">Water moved in interval</p><strong class="mt-1 block text-2xl text-skin-base" data-result="emergencyRemovalLitres">—</strong></div></div><div class="rounded-xl border border-red-500/40 bg-red-500/10 p-4 text-sm leading-6 text-skin-base/80" data-result="warnings">—</div></div></div>
</section>
<script>
  import { calculateBilge } from "@/utils/calculator/bilge";
  document.querySelectorAll<HTMLElement>("[data-bilge-calculator]").forEach(calculator => { const read = (name: string, fallback: number) => { const value = Number((calculator.querySelector(`[data-setting="${name}"]`) as HTMLInputElement | null)?.value); return Number.isFinite(value) ? value : fallback; }; const set = (name: string, value: string) => { const target = calculator.querySelector<HTMLElement>(`[data-result="${name}"]`); if (target) target.textContent = value; }; const calculate = () => { const result = calculateBilge({ pumpRatedFlowLitresPerMinute: read("pumpRatedFlowLitresPerMinute", 100), flowDeratingPercent: read("flowDeratingPercent", 35), pumpCount: read("pumpCount", 1), pumpCurrentAmps: read("pumpCurrentAmps", 8), batteryCapacityAh: read("batteryCapacityAh", 200), batteryUsableDepth: read("batteryUsableDepth", 0.8), batteryVoltage: read("batteryVoltage", 12), emergencyDurationHours: read("emergencyDurationHours", 4) }); set("effectiveFlowLitresPerMinute", `${Math.ceil(result.effectiveFlowLitresPerMinute)} L/min`); set("totalCurrentAmps", `${Math.ceil(result.totalCurrentAmps)} A`); set("batteryRuntimeHours", `${result.batteryRuntimeHours.toFixed(1)} h`); set("emergencyRemovalLitres", `${Math.ceil(result.emergencyRemovalLitres)} L`); set("warnings", result.warnings.join(" ")); }; calculator.querySelectorAll<HTMLInputElement>("[data-setting]").forEach(input => input.addEventListener("input", calculate)); calculate(); });
</script>
