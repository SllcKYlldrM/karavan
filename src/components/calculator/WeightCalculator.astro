---
import CalculatorSafetyNotice from "@/components/calculator/CalculatorSafetyNotice.astro";
---

<section class="rounded-2xl border border-skin-line bg-skin-card p-5 shadow-sm sm:p-7" data-weight-calculator>
  <div class="mb-6 max-w-2xl">
    <p class="mb-2 text-xs font-bold uppercase tracking-[0.18em] text-skin-accent">Planning calculator</p>
    <h2 class="text-2xl font-bold tracking-tight text-skin-base sm:text-3xl">Caravan payload and weight distribution</h2>
    <p class="mt-3 text-sm leading-6 text-skin-base/75">Estimate loaded mass, remaining payload, nose-weight percentage and approximate axle-group load from your measured inputs.</p>
  </div>

  <div class="grid gap-8 lg:grid-cols-[1fr_0.85fr]">
    <div class="grid gap-4 sm:grid-cols-2">
      <label class="text-xs font-semibold text-skin-base/75">Caravan unladen mass (kg)
        <input type="number" min="0" step="1" value="1200" data-setting="caravanUnladenMassKg" class="mt-1.5 w-full rounded-lg border border-skin-line bg-skin-card px-3 py-2.5 text-sm text-skin-base" />
      </label>
      <label class="text-xs font-semibold text-skin-base/75">Caravan MTPLM (kg)
        <input type="number" min="0" step="1" value="1500" data-setting="caravanMtplmKg" class="mt-1.5 w-full rounded-lg border border-skin-line bg-skin-card px-3 py-2.5 text-sm text-skin-base" />
      </label>
      <label class="text-xs font-semibold text-skin-base/75">Cargo, water and equipment (kg)
        <input type="number" min="0" step="1" value="220" data-setting="cargoAndWaterKg" class="mt-1.5 w-full rounded-lg border border-skin-line bg-skin-card px-3 py-2.5 text-sm text-skin-base" />
      </label>
      <label class="text-xs font-semibold text-skin-base/75">Measured nose weight (kg)
        <input type="number" min="0" step="1" value="80" data-setting="noseWeightKg" class="mt-1.5 w-full rounded-lg border border-skin-line bg-skin-card px-3 py-2.5 text-sm text-skin-base" />
      </label>
      <label class="text-xs font-semibold text-skin-base/75">Towbar or vehicle nose limit (kg)
        <input type="number" min="0" step="1" value="100" data-setting="noseWeightLimitKg" class="mt-1.5 w-full rounded-lg border border-skin-line bg-skin-card px-3 py-2.5 text-sm text-skin-base" />
      </label>
      <label class="text-xs font-semibold text-skin-base/75">Caravan axle-group limit (kg)
        <input type="number" min="0" step="1" value="1500" data-setting="axleGroupLimitKg" class="mt-1.5 w-full rounded-lg border border-skin-line bg-skin-card px-3 py-2.5 text-sm text-skin-base" />
      </label>
    </div>

    <div class="space-y-4">
      <h3 class="text-lg font-bold text-skin-base">Weight estimate</h3>
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-1 xl:grid-cols-2">
        <div class="rounded-xl border border-skin-line bg-skin-fill p-4"><p class="text-xs text-skin-base/65">Estimated loaded mass</p><strong class="mt-1 block text-2xl text-skin-base" data-result="loadedMassKg">—</strong></div>
        <div class="rounded-xl border border-skin-line bg-skin-fill p-4"><p class="text-xs text-skin-base/65">Remaining payload</p><strong class="mt-1 block text-2xl text-skin-base" data-result="remainingPayloadKg">—</strong></div>
        <div class="rounded-xl border border-skin-line bg-skin-fill p-4"><p class="text-xs text-skin-base/65">Estimated axle-group load</p><strong class="mt-1 block text-2xl text-skin-base" data-result="estimatedAxleGroupLoadKg">—</strong></div>
        <div class="rounded-xl border border-skin-line bg-skin-fill p-4"><p class="text-xs text-skin-base/65">Nose-weight ratio</p><strong class="mt-1 block text-2xl text-skin-base" data-result="noseWeightPercent">—</strong></div>
      </div>
      <ul class="space-y-2 text-sm leading-6 text-red-700 dark:text-red-300" data-result="warnings"></ul>
      <div class="rounded-xl border border-amber-500/40 bg-amber-500/10 p-4 text-sm leading-6 text-skin-base/80"><strong class="text-skin-base">Safety note:</strong> Water, gas cylinders, batteries and recovery equipment can change axle and nose loads significantly. Distribute mass low and near the axle, secure all items and verify the final combination on a weighbridge.</div>
    </div>
  </div>
  <CalculatorSafetyNotice />
</section>

<script>
  import { calculateWeight } from "@/utils/calculator/weight";

  document.querySelectorAll<HTMLElement>("[data-weight-calculator]").forEach(calculator => {
    if (calculator.dataset.initialized === "true") return;
    calculator.dataset.initialized = "true";
    const read = (name: string, fallback: number) => {
      const value = Number((calculator.querySelector(`[data-setting="${name}"]`) as HTMLInputElement | null)?.value);
      return Number.isFinite(value) ? value : fallback;
    };
    const set = (name: string, value: string) => {
      const target = calculator.querySelector<HTMLElement>(`[data-result="${name}"]`);
      if (target) target.textContent = value;
    };
    const calculate = () => {
      const result = calculateWeight({ caravanUnladenMassKg: read("caravanUnladenMassKg", 1200), caravanMtplmKg: read("caravanMtplmKg", 1500), cargoAndWaterKg: read("cargoAndWaterKg", 220), noseWeightKg: read("noseWeightKg", 80), noseWeightLimitKg: read("noseWeightLimitKg", 100), axleGroupLimitKg: read("axleGroupLimitKg", 1500) });
      set("loadedMassKg", `${result.loadedMassKg.toFixed(0)} kg`);
      set("remainingPayloadKg", `${result.remainingPayloadKg.toFixed(0)} kg`);
      set("estimatedAxleGroupLoadKg", `${result.estimatedAxleGroupLoadKg.toFixed(0)} kg`);
      set("noseWeightPercent", `${result.noseWeightPercent.toFixed(1)}%`);
      const warnings = calculator.querySelector<HTMLElement>('[data-result="warnings"]');
      if (warnings) warnings.innerHTML = result.warnings.map(warning => `<li>• ${warning}</li>`).join("");
    };
    calculator.querySelectorAll<HTMLInputElement>("[data-setting]").forEach(input => input.addEventListener("input", calculate));
    calculate();
  });
</script>
