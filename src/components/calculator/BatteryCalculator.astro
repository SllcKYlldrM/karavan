---
import CalculatorSafetyNotice from "@/components/calculator/CalculatorSafetyNotice.astro";
---

<section class="rounded-2xl border border-skin-line bg-skin-card p-5 shadow-sm sm:p-7" data-battery-calculator>
  <div class="mb-6 max-w-2xl">
    <p class="mb-2 text-xs font-bold uppercase tracking-[0.18em] text-skin-accent">Engineering calculator</p>
    <h2 class="text-2xl font-bold tracking-tight text-skin-base sm:text-3xl">Battery bank sizing</h2>
    <p class="mt-3 text-sm leading-6 text-skin-base/75">Estimate the usable battery bank capacity and the number of batteries required for your off-grid daily energy demand.</p>
  </div>

  <div class="grid gap-8 lg:grid-cols-[1fr_0.85fr]">
    <div class="grid gap-4 sm:grid-cols-2">
      <label class="text-xs font-semibold text-skin-base/75">Daily energy demand (Wh)
        <input type="number" min="1" step="10" value="1000" data-setting="dailyWh" class="mt-1.5 w-full rounded-lg border border-skin-line bg-skin-card px-3 py-2.5 text-sm text-skin-base" />
      </label>
      <label class="text-xs font-semibold text-skin-base/75">System voltage
        <select data-setting="systemVoltage" class="mt-1.5 w-full rounded-lg border border-skin-line bg-skin-card px-3 py-2.5 text-sm text-skin-base"><option value="12">12V</option><option value="24">24V</option><option value="48">48V</option></select>
      </label>
      <label class="text-xs font-semibold text-skin-base/75">Off-grid autonomy (days)
        <input type="number" min="1" step="1" value="2" data-setting="autonomyDays" class="mt-1.5 w-full rounded-lg border border-skin-line bg-skin-card px-3 py-2.5 text-sm text-skin-base" />
      </label>
      <label class="text-xs font-semibold text-skin-base/75">Usable depth of discharge
        <select data-setting="usableDepthOfDischarge" class="mt-1.5 w-full rounded-lg border border-skin-line bg-skin-card px-3 py-2.5 text-sm text-skin-base"><option value="0.8">80% — LiFePO4</option><option value="0.5">50% — AGM / lead-acid</option></select>
      </label>
      <label class="text-xs font-semibold text-skin-base/75">Battery capacity (Ah)
        <input type="number" min="1" step="1" value="200" data-setting="batteryCapacityAh" class="mt-1.5 w-full rounded-lg border border-skin-line bg-skin-card px-3 py-2.5 text-sm text-skin-base" />
      </label>
      <label class="text-xs font-semibold text-skin-base/75">Battery nominal voltage (V)
        <input type="number" min="1" step="0.1" value="12.8" data-setting="batteryNominalVoltage" class="mt-1.5 w-full rounded-lg border border-skin-line bg-skin-card px-3 py-2.5 text-sm text-skin-base" />
      </label>
      <label class="text-xs font-semibold text-skin-base/75">Batteries currently configured
        <input type="number" min="1" step="1" value="1" data-setting="batteryCount" class="mt-1.5 w-full rounded-lg border border-skin-line bg-skin-card px-3 py-2.5 text-sm text-skin-base" />
      </label>
      <label class="text-xs font-semibold text-skin-base/75">Low-temperature capacity factor
        <input type="number" min="0.5" max="1" step="0.01" value="1" data-setting="temperatureFactor" class="mt-1.5 w-full rounded-lg border border-skin-line bg-skin-card px-3 py-2.5 text-sm text-skin-base" />
      </label>
    </div>

    <div class="space-y-4">
      <h3 class="text-lg font-bold text-skin-base">Estimated battery bank</h3>
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-1 xl:grid-cols-2">
        <div class="rounded-xl border border-skin-line bg-skin-fill p-4"><p class="text-xs text-skin-base/65">Required bank capacity</p><strong class="mt-1 block text-2xl text-skin-base" data-result="requiredBankAh">—</strong></div>
        <div class="rounded-xl border border-skin-line bg-skin-fill p-4"><p class="text-xs text-skin-base/65">Recommended battery count</p><strong class="mt-1 block text-2xl text-skin-base" data-result="recommendedBatteryCount">—</strong></div>
        <div class="rounded-xl border border-skin-line bg-skin-fill p-4"><p class="text-xs text-skin-base/65">Configured bank</p><strong class="mt-1 block text-2xl text-skin-base" data-result="configuredBankAh">—</strong></div>
        <div class="rounded-xl border border-skin-line bg-skin-fill p-4"><p class="text-xs text-skin-base/65">Usable stored energy</p><strong class="mt-1 block text-2xl text-skin-base" data-result="usableBankWh">—</strong></div>
      </div>
      <div class="rounded-xl border border-skin-line bg-skin-fill p-4 text-sm leading-6 text-skin-base/75"><strong class="text-skin-base">Result:</strong> <span data-result="status">—</span></div>
      <div class="rounded-xl border border-amber-500/40 bg-amber-500/10 p-4 text-sm leading-6 text-skin-base/80"><strong class="text-skin-base">Safety note:</strong> Battery BMS limits, charge current, temperature protection, parallel-battery wiring and manufacturer installation instructions must be checked before installation.</div>
    </div>
  </div>
</section>

<CalculatorSafetyNotice />

<script>
  import { calculateBatteryBank } from "@/utils/calculator/battery";

  document.querySelectorAll<HTMLElement>("[data-battery-calculator]").forEach(calculator => {
    if (calculator.dataset.initialized === "true") return;
    calculator.dataset.initialized = "true";
    const read = (name: string, fallback: number) => {
      const value = Number((calculator.querySelector(`[data-setting="${name}"]`) as HTMLInputElement | HTMLSelectElement | null)?.value);
      return Number.isFinite(value) ? value : fallback;
    };
    const set = (name: string, value: string) => {
      const target = calculator.querySelector<HTMLElement>(`[data-result="${name}"]`);
      if (target) target.textContent = value;
    };
    const calculate = () => {
      const result = calculateBatteryBank({
        dailyWh: read("dailyWh", 1000),
        systemVoltage: read("systemVoltage", 12),
        autonomyDays: read("autonomyDays", 2),
        usableDepthOfDischarge: read("usableDepthOfDischarge", 0.8),
        batteryCapacityAh: read("batteryCapacityAh", 200),
        batteryNominalVoltage: read("batteryNominalVoltage", 12.8),
        batteryCount: read("batteryCount", 1),
        temperatureFactor: read("temperatureFactor", 1),
      });
      set("requiredBankAh", `${Math.ceil(result.requiredBankAh)} Ah`);
      set("recommendedBatteryCount", `${result.recommendedBatteryCount}`);
      set("configuredBankAh", `${Math.ceil(result.configuredBankAh)} Ah`);
      set("usableBankWh", `${Math.ceil(result.usableBankWh)} Wh`);
      set("status", result.voltageOk && result.capacityOk ? "The configured battery bank covers the entered autonomy target." : "Review the battery voltage and increase the configured bank capacity.");
    };
    calculator.querySelectorAll<HTMLInputElement | HTMLSelectElement>("[data-setting]").forEach(input => input.addEventListener("input", calculate));
    calculate();
  });
</script>
