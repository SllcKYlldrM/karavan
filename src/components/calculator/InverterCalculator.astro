---
import CalculatorSafetyNotice from "@/components/calculator/CalculatorSafetyNotice.astro";
---

<section class="rounded-2xl border border-skin-line bg-skin-card p-5 shadow-sm sm:p-7" data-inverter-calculator>
  <div class="mb-6 max-w-2xl">
    <p class="mb-2 text-xs font-bold uppercase tracking-[0.18em] text-skin-accent">Engineering calculator</p>
    <h2 class="text-2xl font-bold tracking-tight text-skin-base sm:text-3xl">Inverter sizing</h2>
    <p class="mt-3 text-sm leading-6 text-skin-base/75">Estimate continuous and surge inverter requirements from the AC loads that may operate together, then review the DC current drawn from the battery.</p>
  </div>

  <div class="grid gap-8 lg:grid-cols-[1fr_0.85fr]">
    <div class="grid gap-4 sm:grid-cols-2">
      <label class="text-xs font-semibold text-skin-base/75">Simultaneous continuous load (W)
        <input type="number" min="1" step="50" value="1000" data-setting="continuousLoadWatts" class="mt-1.5 w-full rounded-lg border border-skin-line bg-skin-card px-3 py-2.5 text-sm text-skin-base" />
      </label>
      <label class="text-xs font-semibold text-skin-base/75">Total start/surge load (W)
        <input type="number" min="1" step="50" value="2000" data-setting="surgeLoadWatts" class="mt-1.5 w-full rounded-lg border border-skin-line bg-skin-card px-3 py-2.5 text-sm text-skin-base" />
      </label>
      <label class="text-xs font-semibold text-skin-base/75">System voltage
        <select data-setting="systemVoltage" class="mt-1.5 w-full rounded-lg border border-skin-line bg-skin-card px-3 py-2.5 text-sm text-skin-base"><option value="12">12V</option><option value="24">24V</option><option value="48">48V</option></select>
      </label>
      <label class="text-xs font-semibold text-skin-base/75">Inverter efficiency (%)
        <input type="number" min="50" max="100" step="1" value="90" data-setting="inverterEfficiency" class="mt-1.5 w-full rounded-lg border border-skin-line bg-skin-card px-3 py-2.5 text-sm text-skin-base" />
      </label>
      <label class="text-xs font-semibold text-skin-base/75">Continuous design margin
        <select data-setting="continuousMargin" class="mt-1.5 w-full rounded-lg border border-skin-line bg-skin-card px-3 py-2.5 text-sm text-skin-base"><option value="1.2" selected>120%</option><option value="1.25">125%</option><option value="1.5">150%</option></select>
      </label>
      <label class="text-xs font-semibold text-skin-base/75">Surge design margin
        <select data-setting="surgeMargin" class="mt-1.5 w-full rounded-lg border border-skin-line bg-skin-card px-3 py-2.5 text-sm text-skin-base"><option value="1" selected>100%</option><option value="1.25">125%</option><option value="1.5">150%</option></select>
      </label>
      <label class="text-xs font-semibold text-skin-base/75">Selected inverter continuous rating (W)
        <input type="number" min="1" step="50" value="1600" data-setting="selectedContinuousWatts" class="mt-1.5 w-full rounded-lg border border-skin-line bg-skin-card px-3 py-2.5 text-sm text-skin-base" />
      </label>
      <label class="text-xs font-semibold text-skin-base/75">Selected inverter peak rating (W)
        <input type="number" min="1" step="50" value="3500" data-setting="selectedPeakWatts" class="mt-1.5 w-full rounded-lg border border-skin-line bg-skin-card px-3 py-2.5 text-sm text-skin-base" />
      </label>
    </div>

    <div class="space-y-4">
      <h3 class="text-lg font-bold text-skin-base">Inverter estimate</h3>
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-1 xl:grid-cols-2">
        <div class="rounded-xl border border-skin-line bg-skin-fill p-4"><p class="text-xs text-skin-base/65">Recommended continuous class</p><strong class="mt-1 block text-2xl text-skin-base" data-result="recommendedContinuousWatts">—</strong></div>
        <div class="rounded-xl border border-skin-line bg-skin-fill p-4"><p class="text-xs text-skin-base/65">Recommended peak rating</p><strong class="mt-1 block text-2xl text-skin-base" data-result="recommendedPeakWatts">—</strong></div>
        <div class="rounded-xl border border-skin-line bg-skin-fill p-4"><p class="text-xs text-skin-base/65">Battery continuous current</p><strong class="mt-1 block text-2xl text-skin-base" data-result="batteryContinuousCurrent">—</strong></div>
        <div class="rounded-xl border border-skin-line bg-skin-fill p-4"><p class="text-xs text-skin-base/65">Battery peak current</p><strong class="mt-1 block text-2xl text-skin-base" data-result="batteryPeakCurrent">—</strong></div>
      </div>
      <div class="rounded-xl border border-skin-line bg-skin-fill p-4 text-sm leading-6 text-skin-base/75"><strong class="text-skin-base">Compatibility:</strong> <span data-result="status">—</span></div>
      <div class="rounded-xl border border-amber-500/40 bg-amber-500/10 p-4 text-sm leading-6 text-skin-base/80"><strong class="text-skin-base">Safety note:</strong> Motor/compressor loads can have high starting current. Verify the inverter’s continuous output at operating temperature, surge duration, waveform and the battery-side fuse/cable requirements.</div>
    </div>
  </div>
</section>

<CalculatorSafetyNotice />

<script>
  import { calculateInverter } from "@/utils/calculator/inverter";

  document.querySelectorAll<HTMLElement>("[data-inverter-calculator]").forEach(calculator => {
    if (calculator.dataset.initialized === "true") return;
    calculator.dataset.initialized = "true";
    const read = (name: string, fallback: number) => {
      const value = Number((calculator.querySelector(`[data-setting="${name}"]`) as HTMLInputElement | HTMLSelectElement | null)?.value);
      return Number.isFinite(value) ? value : fallback;
    };
    const set = (name: string, value: string) => {
      const target = calculator.querySelector<HTMLElement>(`[data-result="${name}"]`);
      if (target) target.textContent = value;
    };
    const calculate = () => {
      const result = calculateInverter({
        continuousLoadWatts: read("continuousLoadWatts", 1000),
        surgeLoadWatts: read("surgeLoadWatts", 2000),
        systemVoltage: read("systemVoltage", 12),
        inverterEfficiency: read("inverterEfficiency", 90) / 100,
        continuousMargin: read("continuousMargin", 1.2),
        surgeMargin: read("surgeMargin", 1),
        selectedContinuousWatts: read("selectedContinuousWatts", 1600),
        selectedPeakWatts: read("selectedPeakWatts", 3500),
      });
      set("recommendedContinuousWatts", `${result.recommendedContinuousWatts} W`);
      set("recommendedPeakWatts", `${result.recommendedPeakWatts} W`);
      set("batteryContinuousCurrent", `${Math.ceil(result.batteryContinuousCurrent)} A`);
      set("batteryPeakCurrent", `${Math.ceil(result.batteryPeakCurrent)} A`);
      set("status", `${result.continuousOk ? "Continuous rating: OK." : "Continuous rating is too small."} ${result.peakOk ? "Peak rating: OK." : "Peak rating is too small."}`);
    };
    calculator.querySelectorAll<HTMLInputElement | HTMLSelectElement>("[data-setting]").forEach(input => input.addEventListener("input", calculate));
    calculate();
  });
</script>
