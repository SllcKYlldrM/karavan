---
---

<section class="rounded-2xl border border-skin-line bg-skin-card p-5 shadow-sm sm:p-7" data-water-calculator>
  <div class="mb-6 max-w-2xl">
    <p class="mb-2 text-xs font-bold uppercase tracking-[0.18em] text-skin-accent">Planning calculator</p>
    <h2 class="text-2xl font-bold tracking-tight text-skin-base sm:text-3xl">Water tank and autonomy sizing</h2>
    <p class="mt-3 text-sm leading-6 text-skin-base/75">Estimate daily fresh-water use, tank autonomy, water payload and grey-water capacity from editable usage assumptions.</p>
  </div>

  <div class="grid gap-8 lg:grid-cols-[1fr_0.85fr]">
    <div class="grid gap-4 sm:grid-cols-2">
      <label class="text-xs font-semibold text-skin-base/75">Fresh-water tank capacity (L)
        <input type="number" min="1" step="1" value="100" data-setting="tankCapacityLitres" class="mt-1.5 w-full rounded-lg border border-skin-line bg-skin-card px-3 py-2.5 text-sm text-skin-base" />
      </label>
      <label class="text-xs font-semibold text-skin-base/75">People
        <input type="number" min="1" step="1" value="2" data-setting="people" class="mt-1.5 w-full rounded-lg border border-skin-line bg-skin-card px-3 py-2.5 text-sm text-skin-base" />
      </label>
      <label class="text-xs font-semibold text-skin-base/75">Drinking water (L/person/day)
        <input type="number" min="0" step="0.1" value="2" data-setting="drinkingLitresPerPerson" class="mt-1.5 w-full rounded-lg border border-skin-line bg-skin-card px-3 py-2.5 text-sm text-skin-base" />
      </label>
      <label class="text-xs font-semibold text-skin-base/75">Cooking water (L/person/day)
        <input type="number" min="0" step="0.1" value="1" data-setting="cookingLitresPerPerson" class="mt-1.5 w-full rounded-lg border border-skin-line bg-skin-card px-3 py-2.5 text-sm text-skin-base" />
      </label>
      <label class="text-xs font-semibold text-skin-base/75">Dishwashing water (L/person/day)
        <input type="number" min="0" step="0.1" value="3" data-setting="dishesLitresPerPerson" class="mt-1.5 w-full rounded-lg border border-skin-line bg-skin-card px-3 py-2.5 text-sm text-skin-base" />
      </label>
      <label class="text-xs font-semibold text-skin-base/75">Shower time (min/person/day)
        <input type="number" min="0" step="0.5" value="3" data-setting="showerMinutesPerPerson" class="mt-1.5 w-full rounded-lg border border-skin-line bg-skin-card px-3 py-2.5 text-sm text-skin-base" />
      </label>
      <label class="text-xs font-semibold text-skin-base/75">Shower flow (L/min)
        <input type="number" min="0" step="0.1" value="6" data-setting="showerFlowLitresPerMinute" class="mt-1.5 w-full rounded-lg border border-skin-line bg-skin-card px-3 py-2.5 text-sm text-skin-base" />
      </label>
      <label class="text-xs font-semibold text-skin-base/75">Toilet uses (per person/day)
        <input type="number" min="0" step="0.5" value="3" data-setting="toiletUsesPerPerson" class="mt-1.5 w-full rounded-lg border border-skin-line bg-skin-card px-3 py-2.5 text-sm text-skin-base" />
      </label>
      <label class="text-xs font-semibold text-skin-base/75">Water per toilet use (L)
        <input type="number" min="0" step="0.1" value="1" data-setting="toiletLitresPerUse" class="mt-1.5 w-full rounded-lg border border-skin-line bg-skin-card px-3 py-2.5 text-sm text-skin-base" />
      </label>
      <label class="text-xs font-semibold text-skin-base/75">Other use (L/day)
        <input type="number" min="0" step="0.5" value="5" data-setting="otherLitresPerDay" class="mt-1.5 w-full rounded-lg border border-skin-line bg-skin-card px-3 py-2.5 text-sm text-skin-base" />
      </label>
      <label class="text-xs font-semibold text-skin-base/75">Planning reserve
        <select data-setting="reserveFactor" class="mt-1.5 w-full rounded-lg border border-skin-line bg-skin-card px-3 py-2.5 text-sm text-skin-base"><option value="1.1">10%</option><option value="1.2" selected>20%</option><option value="1.3">30%</option></select>
      </label>
      <label class="text-xs font-semibold text-skin-base/75">Grey-water tank capacity (L)
        <input type="number" min="0" step="1" value="80" data-setting="greyWaterTankCapacityLitres" class="mt-1.5 w-full rounded-lg border border-skin-line bg-skin-card px-3 py-2.5 text-sm text-skin-base" />
      </label>
    </div>

    <div class="space-y-4">
      <h3 class="text-lg font-bold text-skin-base">Water estimate</h3>
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-1 xl:grid-cols-2">
        <div class="rounded-xl border border-skin-line bg-skin-fill p-4"><p class="text-xs text-skin-base/65">Daily water use</p><strong class="mt-1 block text-2xl text-skin-base" data-result="dailyUseLitres">—</strong></div>
        <div class="rounded-xl border border-skin-line bg-skin-fill p-4"><p class="text-xs text-skin-base/65">Current tank autonomy</p><strong class="mt-1 block text-2xl text-skin-base" data-result="tankDays">—</strong></div>
        <div class="rounded-xl border border-skin-line bg-skin-fill p-4"><p class="text-xs text-skin-base/65">Required tank with reserve</p><strong class="mt-1 block text-2xl text-skin-base" data-result="requiredTankLitres">—</strong></div>
        <div class="rounded-xl border border-skin-line bg-skin-fill p-4"><p class="text-xs text-skin-base/65">Water payload</p><strong class="mt-1 block text-2xl text-skin-base" data-result="freshWaterWeightKg">—</strong></div>
      </div>
      <div class="rounded-xl border border-skin-line bg-skin-fill p-4 text-sm leading-6 text-skin-base/75"><strong class="text-skin-base">Grey-water estimate:</strong> <span data-result="greyWaterLitres">—</span> <span data-result="status">—</span></div>
      <div class="rounded-xl border border-amber-500/40 bg-amber-500/10 p-4 text-sm leading-6 text-skin-base/80"><strong class="text-skin-base">Safety note:</strong> Actual consumption changes with weather, campsite access, water restrictions, shower flow, toilet type and personal habits. Water weighs approximately 1 kg per litre; include the full tank in payload and axle-load calculations.</div>
    </div>
  </div>
</section>

<script>
  import { calculateWater } from "@/utils/calculator/water";

  document.querySelectorAll<HTMLElement>("[data-water-calculator]").forEach(calculator => {
    if (calculator.dataset.initialized === "true") return;
    calculator.dataset.initialized = "true";
    const read = (name: string, fallback: number) => {
      const value = Number((calculator.querySelector(`[data-setting="${name}"]`) as HTMLInputElement | HTMLSelectElement | null)?.value);
      return Number.isFinite(value) ? value : fallback;
    };
    const set = (name: string, value: string) => {
      const target = calculator.querySelector<HTMLElement>(`[data-result="${name}"]`);
      if (target) target.textContent = value;
    };
    const calculate = () => {
      const result = calculateWater({ tankCapacityLitres: read("tankCapacityLitres", 100), people: read("people", 2), drinkingLitresPerPerson: read("drinkingLitresPerPerson", 2), cookingLitresPerPerson: read("cookingLitresPerPerson", 1), dishesLitresPerPerson: read("dishesLitresPerPerson", 3), showerMinutesPerPerson: read("showerMinutesPerPerson", 3), showerFlowLitresPerMinute: read("showerFlowLitresPerMinute", 6), toiletUsesPerPerson: read("toiletUsesPerPerson", 3), toiletLitresPerUse: read("toiletLitresPerUse", 1), otherLitresPerDay: read("otherLitresPerDay", 5), reserveFactor: read("reserveFactor", 1.2), greyWaterTankCapacityLitres: read("greyWaterTankCapacityLitres", 80) });
      set("dailyUseLitres", `${Math.ceil(result.dailyUseLitres)} L/day`);
      set("tankDays", `${result.tankDays.toFixed(1)} days`);
      set("requiredTankLitres", `${Math.ceil(result.recommendedTankLitres)} L`);
      set("freshWaterWeightKg", `${Math.ceil(result.freshWaterWeightKg)} kg`);
      set("greyWaterLitres", `${Math.ceil(result.greyWaterLitres)} L/day`);
      set("status", result.greyWaterCapacityOk ? "Grey-water capacity: OK for one day." : "Grey-water tank may fill before the fresh-water tank is empty.");
    };
    calculator.querySelectorAll<HTMLInputElement | HTMLSelectElement>("[data-setting]").forEach(input => input.addEventListener("input", calculate));
    calculate();
  });
</script>
