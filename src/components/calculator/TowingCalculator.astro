---
import CalculatorSafetyNotice from "@/components/calculator/CalculatorSafetyNotice.astro";
---

<section class="rounded-2xl border border-skin-line bg-skin-card p-5 shadow-sm sm:p-7" data-towing-calculator>
  <div class="mb-6 max-w-2xl">
    <p class="mb-2 text-xs font-bold uppercase tracking-[0.18em] text-skin-accent">Planning calculator</p>
    <h2 class="text-2xl font-bold tracking-tight text-skin-base sm:text-3xl">Caravan towing and payload check</h2>
    <p class="mt-3 text-sm leading-6 text-skin-base/75">Compare the entered vehicle and caravan limits, estimate the towing ratio, and check remaining payload and nose-weight margins.</p>
  </div>

  <div class="grid gap-8 lg:grid-cols-[1fr_0.85fr]">
    <div class="grid gap-4 sm:grid-cols-2">
      <label class="text-xs font-semibold text-skin-base/75">Vehicle kerbweight (kg)
        <input type="number" min="0" step="1" value="1800" data-setting="vehicleKerbweightKg" class="mt-1.5 w-full rounded-lg border border-skin-line bg-skin-card px-3 py-2.5 text-sm text-skin-base" />
      </label>
      <label class="text-xs font-semibold text-skin-base/75">Vehicle braked towing limit (kg)
        <input type="number" min="0" step="1" value="2000" data-setting="vehicleTowingLimitKg" class="mt-1.5 w-full rounded-lg border border-skin-line bg-skin-card px-3 py-2.5 text-sm text-skin-base" />
      </label>
      <label class="text-xs font-semibold text-skin-base/75">Vehicle payload allowance (kg)
        <input type="number" min="0" step="1" value="600" data-setting="vehiclePayloadLimitKg" class="mt-1.5 w-full rounded-lg border border-skin-line bg-skin-card px-3 py-2.5 text-sm text-skin-base" />
      </label>
      <label class="text-xs font-semibold text-skin-base/75">Passengers and luggage in vehicle (kg)
        <input type="number" min="0" step="1" value="180" data-setting="passengersAndLuggageKg" class="mt-1.5 w-full rounded-lg border border-skin-line bg-skin-card px-3 py-2.5 text-sm text-skin-base" />
      </label>
      <label class="text-xs font-semibold text-skin-base/75">Caravan MTPLM (kg)
        <input type="number" min="0" step="1" value="1500" data-setting="caravanMtplmKg" class="mt-1.5 w-full rounded-lg border border-skin-line bg-skin-card px-3 py-2.5 text-sm text-skin-base" />
      </label>
      <label class="text-xs font-semibold text-skin-base/75">Actual loaded caravan mass (kg)
        <input type="number" min="0" step="1" value="1350" data-setting="caravanActualWeightKg" class="mt-1.5 w-full rounded-lg border border-skin-line bg-skin-card px-3 py-2.5 text-sm text-skin-base" />
      </label>
      <label class="text-xs font-semibold text-skin-base/75">Nose weight (kg)
        <input type="number" min="0" step="1" value="75" data-setting="noseWeightKg" class="mt-1.5 w-full rounded-lg border border-skin-line bg-skin-card px-3 py-2.5 text-sm text-skin-base" />
      </label>
      <label class="text-xs font-semibold text-skin-base/75">Towball limit (kg)
        <input type="number" min="0" step="1" value="100" data-setting="towballLimitKg" class="mt-1.5 w-full rounded-lg border border-skin-line bg-skin-card px-3 py-2.5 text-sm text-skin-base" />
      </label>
    </div>

    <div class="space-y-4">
      <h3 class="text-lg font-bold text-skin-base">Screening result</h3>
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-1 xl:grid-cols-2">
        <div class="rounded-xl border border-skin-line bg-skin-fill p-4"><p class="text-xs text-skin-base/65">Towing ratio</p><strong class="mt-1 block text-2xl text-skin-base" data-result="ratio">—</strong></div>
        <div class="rounded-xl border border-skin-line bg-skin-fill p-4"><p class="text-xs text-skin-base/65">Towing margin</p><strong class="mt-1 block text-2xl text-skin-base" data-result="towingMarginKg">—</strong></div>
        <div class="rounded-xl border border-skin-line bg-skin-fill p-4"><p class="text-xs text-skin-base/65">Remaining payload</p><strong class="mt-1 block text-2xl text-skin-base" data-result="remainingPayloadKg">—</strong></div>
        <div class="rounded-xl border border-skin-line bg-skin-fill p-4"><p class="text-xs text-skin-base/65">Nose weight</p><strong class="mt-1 block text-2xl text-skin-base" data-result="noseWeightPercent">—</strong></div>
      </div>
      <div class="rounded-xl border border-skin-line bg-skin-fill p-4 text-sm leading-6 text-skin-base/75"><strong class="text-skin-base">MTPLM headroom:</strong> <span data-result="mtplmMarginKg">—</span></div>
      <div class="rounded-xl border border-amber-500/40 bg-amber-500/10 p-4 text-sm leading-6 text-skin-base/80"><strong class="text-skin-base">Do not use this as a legal approval:</strong> manufacturer limits, axle loads, towbar rating, tyres, brakes, licence category, loading distribution and local regulations always take priority. Weigh the loaded combination where possible.</div>
      <ul class="space-y-2 text-sm leading-6 text-red-700 dark:text-red-300" data-result="warnings"></ul>
    </div>
  </div>
  <CalculatorSafetyNotice />
</section>

<script>
  import { calculateTowing } from "@/utils/calculator/towing";

  document.querySelectorAll<HTMLElement>("[data-towing-calculator]").forEach(calculator => {
    if (calculator.dataset.initialized === "true") return;
    calculator.dataset.initialized = "true";
    const read = (name: string, fallback: number) => {
      const value = Number((calculator.querySelector(`[data-setting="${name}"]`) as HTMLInputElement | null)?.value);
      return Number.isFinite(value) ? value : fallback;
    };
    const set = (name: string, value: string) => {
      const target = calculator.querySelector<HTMLElement>(`[data-result="${name}"]`);
      if (target) target.textContent = value;
    };
    const calculate = () => {
      const result = calculateTowing({ vehicleKerbweightKg: read("vehicleKerbweightKg", 1800), vehicleTowingLimitKg: read("vehicleTowingLimitKg", 2000), vehiclePayloadLimitKg: read("vehiclePayloadLimitKg", 600), passengersAndLuggageKg: read("passengersAndLuggageKg", 180), caravanMtplmKg: read("caravanMtplmKg", 1500), caravanActualWeightKg: read("caravanActualWeightKg", 1350), noseWeightKg: read("noseWeightKg", 75), towballLimitKg: read("towballLimitKg", 100) });
      set("ratio", `${result.ratio.toFixed(1)}%`);
      set("towingMarginKg", `${result.towingMarginKg.toFixed(0)} kg`);
      set("remainingPayloadKg", `${result.remainingPayloadKg.toFixed(0)} kg`);
      set("noseWeightPercent", `${result.noseWeightPercent.toFixed(1)}%`);
      set("mtplmMarginKg", `${result.mtplmMarginKg.toFixed(0)} kg`);
      const warnings = calculator.querySelector<HTMLElement>('[data-result="warnings"]');
      if (warnings) warnings.innerHTML = result.warnings.map(warning => `<li>• ${warning}</li>`).join("");
    };
    calculator.querySelectorAll<HTMLInputElement>("[data-setting]").forEach(input => input.addEventListener("input", calculate));
    calculate();
  });
</script>
