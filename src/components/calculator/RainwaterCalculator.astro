---
import PlanningSafetyNotice from "@/components/calculator/PlanningSafetyNotice.astro";
---

<section class="rounded-2xl border border-skin-line bg-skin-card p-5 shadow-sm sm:p-7" data-rainwater-calculator>
  <div class="mb-6 max-w-2xl"><p class="mb-2 text-xs font-bold uppercase tracking-[0.18em] text-skin-accent">Tiny house and off-grid planning calculator</p><h2 class="text-2xl font-bold tracking-tight text-skin-base sm:text-3xl">Rainwater harvesting and cistern sizing</h2><p class="mt-3 text-sm leading-6 text-skin-base/75">Estimate water captured from a roof and the storage volume required for a defined demand period.</p></div>
  <div class="grid gap-8 lg:grid-cols-[1fr_0.85fr]"><div class="grid gap-4 sm:grid-cols-2">
    <label class="text-xs font-semibold text-skin-base/75">Catchment roof area (m²)<input type="number" min="0" value="30" data-setting="roofAreaM2" class="mt-1.5 w-full rounded-lg border border-skin-line bg-skin-card px-3 py-2.5 text-sm text-skin-base" /></label>
    <label class="text-xs font-semibold text-skin-base/75">Rainfall event (mm)<input type="number" min="0" value="20" data-setting="rainfallMm" class="mt-1.5 w-full rounded-lg border border-skin-line bg-skin-card px-3 py-2.5 text-sm text-skin-base" /></label>
    <label class="text-xs font-semibold text-skin-base/75">Runoff coefficient<input type="number" min="0" max="1" step="0.05" value="0.8" data-setting="runoffCoefficient" class="mt-1.5 w-full rounded-lg border border-skin-line bg-skin-card px-3 py-2.5 text-sm text-skin-base" /></label>
    <label class="text-xs font-semibold text-skin-base/75">Filter/first-flush efficiency<input type="number" min="0" max="1" step="0.05" value="0.9" data-setting="filterEfficiency" class="mt-1.5 w-full rounded-lg border border-skin-line bg-skin-card px-3 py-2.5 text-sm text-skin-base" /></label>
    <label class="text-xs font-semibold text-skin-base/75">Daily demand (L/day)<input type="number" min="0" value="60" data-setting="dailyDemandLitres" class="mt-1.5 w-full rounded-lg border border-skin-line bg-skin-card px-3 py-2.5 text-sm text-skin-base" /></label>
    <label class="text-xs font-semibold text-skin-base/75">Storage target (days)<input type="number" min="0" value="7" data-setting="storageDays" class="mt-1.5 w-full rounded-lg border border-skin-line bg-skin-card px-3 py-2.5 text-sm text-skin-base" /></label>
    <label class="text-xs font-semibold text-skin-base/75">Existing tank capacity (L)<input type="number" min="0" value="500" data-setting="tankCapacityLitres" class="mt-1.5 w-full rounded-lg border border-skin-line bg-skin-card px-3 py-2.5 text-sm text-skin-base" /></label>
  </div><div class="space-y-4"><h3 class="text-lg font-bold text-skin-base">Harvest estimate</h3><div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-1 xl:grid-cols-2"><div class="rounded-xl border border-skin-line bg-skin-fill p-4"><p class="text-xs text-skin-base/65">Captured per event</p><strong class="mt-1 block text-2xl text-skin-base" data-result="capturedLitres">—</strong></div><div class="rounded-xl border border-skin-line bg-skin-fill p-4"><p class="text-xs text-skin-base/65">Recommended storage</p><strong class="mt-1 block text-2xl text-skin-base" data-result="recommendedTankLitres">—</strong></div><div class="rounded-xl border border-skin-line bg-skin-fill p-4"><p class="text-xs text-skin-base/65">Existing tank autonomy</p><strong class="mt-1 block text-2xl text-skin-base" data-result="tankDays">—</strong></div></div><div class="rounded-xl border border-amber-500/40 bg-amber-500/10 p-4 text-sm leading-6 text-skin-base/80" data-result="warnings">—</div></div></div>
</section>

<PlanningSafetyNotice />
<script>
  import { calculateRainwater } from "@/utils/calculator/rainwater";
  document.querySelectorAll<HTMLElement>("[data-rainwater-calculator]").forEach(calculator => { const read = (name: string, fallback: number) => { const value = Number((calculator.querySelector(`[data-setting="${name}"]`) as HTMLInputElement | null)?.value); return Number.isFinite(value) ? value : fallback; }; const set = (name: string, value: string) => { const target = calculator.querySelector<HTMLElement>(`[data-result="${name}"]`); if (target) target.textContent = value; }; const calculate = () => { const result = calculateRainwater({ roofAreaM2: read("roofAreaM2", 30), rainfallMm: read("rainfallMm", 20), runoffCoefficient: read("runoffCoefficient", 0.8), filterEfficiency: read("filterEfficiency", 0.9), dailyDemandLitres: read("dailyDemandLitres", 60), storageDays: read("storageDays", 7), tankCapacityLitres: read("tankCapacityLitres", 500) }); set("capturedLitres", `${Math.ceil(result.capturedLitres)} L`); set("recommendedTankLitres", `${Math.ceil(result.recommendedTankLitres)} L`); set("tankDays", `${result.tankDays.toFixed(1)} days`); set("warnings", result.warnings.join(" ")); }; calculator.querySelectorAll<HTMLInputElement>("[data-setting]").forEach(input => input.addEventListener("input", calculate)); calculate(); });
</script>
