---
import PlanningSafetyNotice from "@/components/calculator/PlanningSafetyNotice.astro";
---

<section class="rounded-2xl border border-skin-line bg-skin-card p-5 shadow-sm sm:p-7" data-heat-loss-calculator>
  <div class="mb-6 max-w-2xl"><p class="mb-2 text-xs font-bold uppercase tracking-[0.18em] text-skin-accent">Tiny house planning calculator</p><h2 class="text-2xl font-bold tracking-tight text-skin-base sm:text-3xl">Heat-loss and HVAC planning</h2><p class="mt-3 text-sm leading-6 text-skin-base/75">Estimate transmission and ventilation heat loss from a simplified building envelope model.</p></div>
  <div class="grid gap-8 lg:grid-cols-[1fr_0.85fr]">
    <div class="grid gap-4 sm:grid-cols-2">
      <label class="text-xs font-semibold text-skin-base/75">Floor area (m²)<input type="number" min="0" value="30" data-setting="floorAreaM2" class="mt-1.5 w-full rounded-lg border border-skin-line bg-skin-card px-3 py-2.5 text-sm text-skin-base" /></label>
      <label class="text-xs font-semibold text-skin-base/75">Wall area (m²)<input type="number" min="0" value="55" data-setting="wallAreaM2" class="mt-1.5 w-full rounded-lg border border-skin-line bg-skin-card px-3 py-2.5 text-sm text-skin-base" /></label>
      <label class="text-xs font-semibold text-skin-base/75">Roof area (m²)<input type="number" min="0" value="30" data-setting="roofAreaM2" class="mt-1.5 w-full rounded-lg border border-skin-line bg-skin-card px-3 py-2.5 text-sm text-skin-base" /></label>
      <label class="text-xs font-semibold text-skin-base/75">Window/door area (m²)<input type="number" min="0" value="8" data-setting="windowAreaM2" class="mt-1.5 w-full rounded-lg border border-skin-line bg-skin-card px-3 py-2.5 text-sm text-skin-base" /></label>
      <label class="text-xs font-semibold text-skin-base/75">Wall U-value (W/m²K)<input type="number" min="0" step="0.01" value="0.25" data-setting="wallUValue" class="mt-1.5 w-full rounded-lg border border-skin-line bg-skin-card px-3 py-2.5 text-sm text-skin-base" /></label>
      <label class="text-xs font-semibold text-skin-base/75">Roof U-value (W/m²K)<input type="number" min="0" step="0.01" value="0.18" data-setting="roofUValue" class="mt-1.5 w-full rounded-lg border border-skin-line bg-skin-card px-3 py-2.5 text-sm text-skin-base" /></label>
      <label class="text-xs font-semibold text-skin-base/75">Floor U-value (W/m²K)<input type="number" min="0" step="0.01" value="0.3" data-setting="floorUValue" class="mt-1.5 w-full rounded-lg border border-skin-line bg-skin-card px-3 py-2.5 text-sm text-skin-base" /></label>
      <label class="text-xs font-semibold text-skin-base/75">Window U-value (W/m²K)<input type="number" min="0" step="0.01" value="1.4" data-setting="windowUValue" class="mt-1.5 w-full rounded-lg border border-skin-line bg-skin-card px-3 py-2.5 text-sm text-skin-base" /></label>
      <label class="text-xs font-semibold text-skin-base/75">Indoor design temperature (°C)<input type="number" value="21" data-setting="indoorTemperatureC" class="mt-1.5 w-full rounded-lg border border-skin-line bg-skin-card px-3 py-2.5 text-sm text-skin-base" /></label>
      <label class="text-xs font-semibold text-skin-base/75">Outdoor design temperature (°C)<input type="number" value="-5" data-setting="outdoorDesignTemperatureC" class="mt-1.5 w-full rounded-lg border border-skin-line bg-skin-card px-3 py-2.5 text-sm text-skin-base" /></label>
      <label class="text-xs font-semibold text-skin-base/75">Interior volume (m³)<input type="number" min="0" value="75" data-setting="volumeM3" class="mt-1.5 w-full rounded-lg border border-skin-line bg-skin-card px-3 py-2.5 text-sm text-skin-base" /></label>
      <label class="text-xs font-semibold text-skin-base/75">Air changes per hour<input type="number" min="0" step="0.1" value="0.5" data-setting="airChangesPerHour" class="mt-1.5 w-full rounded-lg border border-skin-line bg-skin-card px-3 py-2.5 text-sm text-skin-base" /></label>
      <label class="text-xs font-semibold text-skin-base/75">Internal gains (W)<input type="number" min="0" value="300" data-setting="internalGainsWatts" class="mt-1.5 w-full rounded-lg border border-skin-line bg-skin-card px-3 py-2.5 text-sm text-skin-base" /></label>
      <label class="text-xs font-semibold text-skin-base/75">Planning safety factor<input type="number" min="1" max="2" step="0.05" value="1.2" data-setting="safetyFactor" class="mt-1.5 w-full rounded-lg border border-skin-line bg-skin-card px-3 py-2.5 text-sm text-skin-base" /></label>
    </div>
    <div class="space-y-4"><h3 class="text-lg font-bold text-skin-base">Estimated design load</h3><div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-1 xl:grid-cols-2"><div class="rounded-xl border border-skin-line bg-skin-fill p-4"><p class="text-xs text-skin-base/65">Transmission loss</p><strong class="mt-1 block text-2xl text-skin-base" data-result="transmissionWatts">—</strong></div><div class="rounded-xl border border-skin-line bg-skin-fill p-4"><p class="text-xs text-skin-base/65">Ventilation loss</p><strong class="mt-1 block text-2xl text-skin-base" data-result="ventilationWatts">—</strong></div><div class="rounded-xl border border-skin-line bg-skin-fill p-4"><p class="text-xs text-skin-base/65">Design heating load</p><strong class="mt-1 block text-2xl text-skin-base" data-result="designHeatLoadWatts">—</strong></div><div class="rounded-xl border border-skin-line bg-skin-fill p-4"><p class="text-xs text-skin-base/65">Design load</p><strong class="mt-1 block text-2xl text-skin-base" data-result="designHeatLoadBtuPerHour">—</strong></div></div><div class="rounded-xl border border-red-500/40 bg-red-500/10 p-4 text-sm leading-6 text-skin-base/80" data-result="warnings">—</div></div>
  </div>
</section>

<PlanningSafetyNotice />
<script>
  import { calculateHeatLoss } from "@/utils/calculator/heat-loss";
  document.querySelectorAll<HTMLElement>("[data-heat-loss-calculator]").forEach(calculator => { const read = (name: string, fallback: number) => { const value = Number((calculator.querySelector(`[data-setting="${name}"]`) as HTMLInputElement | null)?.value); return Number.isFinite(value) ? value : fallback; }; const set = (name: string, value: string) => { const target = calculator.querySelector<HTMLElement>(`[data-result="${name}"]`); if (target) target.textContent = value; }; const calculate = () => { const result = calculateHeatLoss({ floorAreaM2: read("floorAreaM2", 30), wallAreaM2: read("wallAreaM2", 55), roofAreaM2: read("roofAreaM2", 30), windowAreaM2: read("windowAreaM2", 8), wallUValue: read("wallUValue", 0.25), roofUValue: read("roofUValue", 0.18), floorUValue: read("floorUValue", 0.3), windowUValue: read("windowUValue", 1.4), indoorTemperatureC: read("indoorTemperatureC", 21), outdoorDesignTemperatureC: read("outdoorDesignTemperatureC", -5), volumeM3: read("volumeM3", 75), airChangesPerHour: read("airChangesPerHour", 0.5), internalGainsWatts: read("internalGainsWatts", 300), safetyFactor: read("safetyFactor", 1.2) }); set("transmissionWatts", `${Math.ceil(result.transmissionWatts)} W`); set("ventilationWatts", `${Math.ceil(result.ventilationWatts)} W`); set("designHeatLoadWatts", `${Math.ceil(result.designHeatLoadWatts)} W`); set("designHeatLoadBtuPerHour", `${Math.ceil(result.designHeatLoadBtuPerHour)} BTU/h`); set("warnings", result.warnings.join(" ")); }; calculator.querySelectorAll<HTMLInputElement>("[data-setting]").forEach(input => input.addEventListener("input", calculate)); calculate(); });
</script>
<style>
  [data-heat-loss-calculator] input { min-height: 2.75rem; }
</style>
