---
import type { CollectionEntry } from "astro:content";
import Datetime from "./Datetime.astro";
import { getRelativeLocaleUrl } from "astro:i18n";
import config from "@/config";

export interface Props {
  href?: string;
  frontmatter?: CollectionEntry<"posts">["data"];
  data?: CollectionEntry<"posts">["data"];
  id?: string;
  variant?: "h2" | "h3";
  secHeading?: boolean;
}

const { href, frontmatter, data, id, variant = "h2" } = Astro.props;

const postData = frontmatter ?? data;
if (!postData) {
  throw new Error("Card bileşenine geçerli bir veri iletilmedi.");
}

const { title, pubDatetime, modDatetime, description, ogImage, tags } = postData;

const locale = Astro.currentLocale ?? config.site.lang;
// TypeScript hatasını engellemek için tip güvenli slug çözümlemesi:
const rawSlug = (postData as Record<string, any>).postSlug ?? id?.replace(/\.[^/.]+$/, "");
const postHref = href ?? getRelativeLocaleUrl(locale, `posts/${rawSlug}`);

const HeadingTag = variant;
const coverImageSrc = ogImage && typeof ogImage === "string" ? ogImage : "/images/default-og.jpg";
const primaryTag = tags && tags.length > 0 ? tags[0] : null;
---

<article class="group flex flex-col h-full overflow-hidden rounded-xl border border-skin-line/60 bg-skin-card transition-all duration-300 hover:border-skin-accent hover:shadow-lg">
  <!-- Kapak Görseli ve Kategori Rozeti -->
  <a href={postHref} class="relative block aspect-video w-full overflow-hidden bg-skin-card-muted">
    <img
      src={coverImageSrc}
      alt={title}
      loading="lazy"
      decoding="async"
      class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
    />
    {primaryTag && (
      <span class="absolute top-3 left-3 rounded-md border border-skin-line/40 bg-skin-fill/90 px-2.5 py-1 text-xs font-semibold text-skin-accent backdrop-blur-sm shadow-sm">
        {primaryTag}
      </span>
    )}
  </a>

  <!-- İçerik Alanı -->
  <div class="flex flex-1 flex-col justify-between p-5">
    <div>
      <HeadingTag class="text-lg font-bold tracking-tight text-skin-base transition-colors group-hover:text-skin-accent line-clamp-2">
        <a href={postHref}>{title}</a>
      </HeadingTag>

      <div class="mt-2 text-xs text-skin-base/70">
        <Datetime pubDatetime={pubDatetime} modDatetime={modDatetime} />
      </div>

      <p class="mt-3 text-sm leading-relaxed text-skin-base/80 line-clamp-3">
        {description}
      </p>
    </div>

    <div class="mt-4 flex items-center justify-between border-t border-skin-line/40 pt-3 text-xs font-medium text-skin-accent">
      <span>Read Guide</span>
      <span class="transition-transform duration-300 group-hover:translate-x-1">&rarr;</span>
    </div>
  </div>
</article>
