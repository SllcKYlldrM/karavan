---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Datetime from "@/components/Datetime.astro";

// TypeScript hatasını önleyen esnek prop tanımı
export interface Props {
  title?: string;
  author?: string;
  description?: string;
  ogImage?: any;
  canonicalURL?: string;
  pubDatetime?: Date;
  modDatetime?: Date | null;
  [key: string]: any;
}

const {
  title,
  author = "Editorial Staff",
  description = "",
  ogImage,
  canonicalURL,
  pubDatetime,
  modDatetime,
} = Astro.props;

const allPosts = await getCollection("posts", ({ data }) => !data.draft);
const sortedPosts = allPosts.sort(
  (a, b) => b.data.pubDatetime.valueOf() - a.data.pubDatetime.valueOf()
);

// URL slug parametresine göre geçerli yazıyı ve ek verileri bul
const { slug } = Astro.params;
const post = allPosts.find(p => {
  const postSlug = p.data.postSlug ?? p.id?.replace(/\.[^/.]+$/, "");
  return postSlug === slug || p.id === slug;
});

const getSlug = (p: any) => p.data.postSlug ?? p.id?.replace(/\.[^/.]+$/, "");
const getCover = (p: any) =>
  p.data.ogImage && typeof p.data.ogImage === "string"
    ? p.data.ogImage
    : "/images/default-og.jpg";

const displayTitle = post?.data.title ?? (title ? title.split(" | ")[0] : "Technical Guide");
const displayAuthor = post?.data.author || author;
const displayCover = post?.data.ogImage && typeof post.data.ogImage === "string"
  ? post.data.ogImage
  : (typeof ogImage === "string" ? ogImage : "/images/default-og.jpg");

const tags = post?.data.tags || [];
const primaryTag = tags[0] || "Caravan";

// Okuma süresi tahmini
const wordCount = (post as any)?.body ? (post as any).body.split(/\s+/).length : 600;
const readingTime = `${Math.ceil(wordCount / 200)} min read`;

// Benzer yazılar ve popüler liste
const relatedPosts = sortedPosts
  .filter(p => (post ? p.id !== post.id : true) && p.data.tags?.some(t => tags.includes(t)))
  .slice(0, 2);
const finalRelated = relatedPosts.length > 0 ? relatedPosts : sortedPosts.slice(0, 2);
const popularPosts = sortedPosts.slice(0, 5);

const shareUrl = encodeURIComponent(Astro.url.href);
const shareTitle = encodeURIComponent(displayTitle);
---

<Layout
  title={`${displayTitle} | Caravan Tech Portal`}
  description={description || post?.data.description}
  ogImage={displayCover}
  canonicalURL={canonicalURL}
  pubDatetime={pubDatetime || post?.data.pubDatetime}
  modDatetime={modDatetime || post?.data.modDatetime}
>
  <Header />

  <main id="main-content" class="mx-auto max-w-7xl px-4 py-6 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 py-4">
      
      <!-- LEFT ARTICLE CONTENT -->
      <div class="lg:col-span-2 py-2">
        <h1 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-skin-base leading-tight">
          {displayTitle}
        </h1>

        <!-- Meta Bar -->
        <div class="mt-4 pb-4 w-full flex flex-wrap items-center gap-4 text-xs sm:text-sm text-skin-base/70 border-b border-skin-line/60">
          <span class="flex items-center gap-1.5 font-medium">
            <svg class="size-3.5" viewBox="0 0 16 16" fill="currentColor"><path d="M8 8a3 3 0 1 0 0-6a3 3 0 0 0 0 6m2-3a2 2 0 1 1-4 0a2 2 0 0 1 4 0m4 8c0 1-1 1-1 1H3s-1 0-1-1s1-4 6-4s6 3 6 4m-1-.004c-.001-.246-.154-.986-.832-1.664C11.516 10.68 10.289 10 8 10s-3.516.68-4.168 1.332c-.678.678-.83 1.418-.832 1.664z"/></svg>
            by {displayAuthor}
          </span>
          <span class="flex items-center gap-1.5">
            <svg class="size-3.5" viewBox="0 0 16 16" fill="currentColor"><path d="M3.5 0a.5.5 0 0 1 .5.5V1h8V.5a.5.5 0 0 1 1 0V1h1a2 2 0 0 1 2 2v11a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V3a2 2 0 0 1 2-2h1V.5a.5.5 0 0 1 .5-.5M1 4v10a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V4z"/></svg>
            <Datetime pubDatetime={pubDatetime || post?.data.pubDatetime} modDatetime={modDatetime || post?.data.modDatetime} />
          </span>
          <a href={`/tags/${primaryTag.toLowerCase()}`} class="flex items-center gap-1.5 text-skin-accent hover:underline font-medium">
            <svg class="size-3.5" viewBox="0 0 16 16" fill="currentColor"><path d="M2 2a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v13.5a.5.5 0 0 1-.777.416L8 13.101l-5.223 2.815A.5.5 0 0 1 2 15.5zm2-1a1 1 0 0 0-1 1v12.566l4.723-2.482a.5.5 0 0 1 .554 0L13 14.566V2a1 1 0 0 0-1-1z"/></svg>
            {primaryTag}
          </a>
          <span class="flex items-center gap-1.5 text-skin-base/60">
            <svg class="size-3.5" viewBox="0 0 16 16" fill="currentColor"><path d="M8 3.5a.5.5 0 0 0-1 0V9a.5.5 0 0 0 .252.434l3.5 2a.5.5 0 0 0 .496-.868L8 8.71z"/><path d="M8 16A8 8 0 1 0 8 0a8 8 0 0 0 0 16m7-8A7 7 0 1 1 1 8a7 7 0 0 1 14 0"/></svg>
            {readingTime}
          </span>
        </div>

        <!-- Cover Image -->
        <div class="aspect-[2/1] overflow-hidden w-full bg-slate-100 dark:bg-slate-900 rounded-xl my-6 border border-skin-line/40">
          <img src={displayCover} alt={displayTitle} class="w-full h-full object-cover" />
        </div>

        <!-- Content Body (Rendered Markdown Slot) -->
        <div class="relative post-content pt-2 prose prose-slate max-w-none dark:prose-invert prose-headings:font-heading prose-headings:font-bold prose-headings:text-skin-base prose-p:text-skin-base/90 prose-p:leading-relaxed prose-img:rounded-xl">
          <slot />
        </div>

        <!-- Tags & Share Bar -->
        <div class="flex flex-col sm:flex-row items-center justify-between gap-3 py-4 border-y border-skin-line/60 mt-10">
          <ul class="flex flex-wrap items-center gap-2 text-xs">
            {tags.map(tag => (
              <li>
                <a href={`/tags/${tag.toLowerCase()}`} class="flex py-1 px-3 bg-skin-card hover:border-skin-accent rounded border border-skin-line/70 text-skin-base transition-colors">
                  #{tag}
                </a>
              </li>
            ))}
          </ul>
          <div class="flex items-center gap-3 text-xs font-semibold text-skin-base/70">
            <span>Share:</span>
            <a href={`https://twitter.com/intent/tweet?url=${shareUrl}&text=${shareTitle}`} target="_blank" rel="noopener noreferrer" class="hover:text-skin-accent transition-colors">X</a>
            <a href={`https://www.linkedin.com/shareArticle?mini=true&url=${shareUrl}&title=${shareTitle}`} target="_blank" rel="noopener noreferrer" class="hover:text-skin-accent transition-colors">LinkedIn</a>
            <a href={`https://api.whatsapp.com/send?text=${shareTitle}%20${shareUrl}`} target="_blank" rel="noopener noreferrer" class="hover:text-skin-accent transition-colors">WhatsApp</a>
          </div>
        </div>

        <!-- Author Bio Box -->
        <div class="flex flex-row items-center py-6 border-b border-skin-line/60 gap-5">
          <div class="size-16 rounded-full bg-skin-accent/15 flex items-center justify-center font-bold text-xl text-skin-accent shrink-0 border border-skin-accent/20">
            {displayAuthor.charAt(0)}
          </div>
          <div>
            <h4 class="text-lg font-bold text-skin-base">{displayAuthor}</h4>
            <p class="text-xs sm:text-sm text-skin-base/75 mt-1 leading-relaxed">
              Technical writer specialized in mobile electrical engineering, LiFePO4 battery banks, solar arrays, and high-altitude diesel heating calibration.
            </p>
          </div>
        </div>

        <!-- Related Articles -->
        {finalRelated.length > 0 && (
          <div class="py-6 border-b border-skin-line/60">
            <h3 class="text-lg font-bold text-skin-base mb-4">Related Articles</h3>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              {finalRelated.map(item => (
                <a href={`/posts/${getSlug(item)}`} class="group flex gap-3 p-3 rounded-lg border border-skin-line/50 bg-skin-card hover:border-skin-accent transition-all">
                  <img src={getCover(item)} alt={item.data.title} class="size-16 object-cover rounded-md shrink-0 bg-skin-card-muted" />
                  <div class="flex flex-col justify-center">
                    <h5 class="text-xs font-bold text-skin-base leading-snug line-clamp-2 group-hover:text-skin-accent transition-colors">
                      {item.data.title}
                    </h5>
                    <span class="text-[10px] text-skin-base/60 mt-1">
                      <Datetime pubDatetime={item.data.pubDatetime} />
                    </span>
                  </div>
                </a>
              ))}
            </div>
          </div>
        )}
      </div>

      <!-- RIGHT SIDEBAR -->
      <aside class="lg:col-span-1 lg:ps-4">
        <div class="flex flex-col gap-6 sticky top-24">
          
          <!-- POPULAR POSTS -->
          <div class="bg-skin-card border border-skin-line/60 rounded-xl p-5 shadow-xs">
            <h3 class="w-full pb-3 border-b border-skin-line/50 font-bold text-sm uppercase tracking-wider text-skin-base flex items-center gap-2">
              <span class="size-2 rounded-full bg-skin-accent"></span>
              Popular Posts
            </h3>
            <div class="divide-y divide-skin-line/40 pt-1">
              {popularPosts.map((p, idx) => (
                <a href={`/posts/${getSlug(p)}`} class="flex items-start gap-3 py-3 group">
                  <span class="size-6 shrink-0 rounded-full bg-slate-900 text-white text-xs font-bold flex items-center justify-center">
                    {idx + 1}
                  </span>
                  <div class="flex flex-col">
                    <h4 class="text-xs font-bold text-skin-base group-hover:text-skin-accent line-clamp-2 transition-colors">
                      {p.data.title}
                    </h4>
                    <span class="text-[10px] text-skin-base/60 mt-1">
                      <Datetime pubDatetime={p.data.pubDatetime} />
                    </span>
                  </div>
                </a>
              ))}
            </div>
          </div>

        </div>
      </aside>

    </div>
  </main>

  <Footer />
</Layout>
