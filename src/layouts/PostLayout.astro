---
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Datetime from "@/components/Datetime.astro";

export interface Props {
  post: CollectionEntry<"posts">;
  posts?: CollectionEntry<"posts">[];
}

const { post } = Astro.props;
const { Content } = await render(post);

const allPosts = await getCollection("posts", ({ data }) => !data.draft);
const sortedPosts = allPosts.sort(
  (a, b) => b.data.pubDatetime.valueOf() - a.data.pubDatetime.valueOf()
);

const getSlug = (p: any) => p.data.postSlug ?? p.id?.replace(/\.[^/.]+$/, "");
const getCover = (p: any) =>
  p.data.ogImage && typeof p.data.ogImage === "string"
    ? p.data.ogImage
    : "/images/default-og.jpg";

// Related Posts (Aynı etikete sahip diğer yazılar)
const currentTag = post.data.tags?.[0];
const relatedPosts = sortedPosts
  .filter(p => p.id !== post.id && p.data.tags?.includes(currentTag))
  .slice(0, 2);

const popularPosts = sortedPosts.filter(p => p.id !== post.id).slice(0, 5);

// Yaklaşık okuma süresi
const wordCount = post.body?.split(/\s+/).length || 500;
const readingTime = `${Math.ceil(wordCount / 200)} min read`;

const shareUrl = encodeURIComponent(Astro.url.href);
const shareTitle = encodeURIComponent(post.data.title);
---

<Layout title={post.data.title} description={post.data.description} ogImage={getCover(post)}>
  <Header />

  <main id="main-content" class="mx-auto max-w-7xl px-4 py-6 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 py-4">
      
      <!-- LEFT ARTICLE CONTENT (2 COLUMNS) -->
      <div class="lg:col-span-2">
        <h1 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-skin-base leading-tight">
          {post.data.title}
        </h1>

        <!-- META BAR -->
        <div class="mt-4 pb-4 flex flex-wrap items-center gap-4 text-xs sm:text-sm text-skin-base/70 border-b border-skin-line/60">
          <span>By {post.data.author || "Editorial Staff"}</span>
          <span>•</span>
          <Datetime pubDatetime={post.data.pubDatetime} modDatetime={post.data.modDatetime} />
          {currentTag && (
            <>
              <span>•</span>
              <a href={`/tags/${currentTag.toLowerCase()}`} class="text-skin-accent font-medium hover:underline">
                {currentTag}
              </a>
            </>
          )}
          <span>•</span>
          <span>{readingTime}</span>
        </div>

        <!-- COVER IMAGE -->
        <div class="my-6 aspect-[2/1] w-full overflow-hidden rounded-xl bg-skin-card-muted border border-skin-line/40">
          <img
            src={getCover(post)}
            alt={post.data.title}
            class="h-full w-full object-cover"
          />
        </div>

        <!-- POST BODY -->
        <article class="prose prose-slate max-w-none dark:prose-invert prose-headings:font-bold prose-headings:text-skin-base prose-p:text-skin-base/90 prose-p:leading-relaxed prose-img:rounded-xl">
          <Content />
        </article>

        <!-- TAGS & SHARE BAR -->
        <div class="mt-10 flex flex-col sm:flex-row sm:items-center justify-between gap-4 py-4 border-y border-skin-line/60">
          <ul class="flex flex-wrap items-center gap-2">
            {post.data.tags?.map(tag => (
              <li>
                <a href={`/tags/${tag.toLowerCase()}`} class="rounded border border-skin-line/70 bg-skin-fill px-2.5 py-1 text-xs text-skin-base hover:border-skin-accent transition-colors">
                  {tag}
                </a>
              </li>
            ))}
          </ul>

          <!-- Share Icons -->
          <div class="flex items-center gap-3 text-xs font-semibold text-skin-base/80">
            <span>Share:</span>
            <a href={`https://twitter.com/intent/tweet?url=${shareUrl}&text=${shareTitle}`} target="_blank" rel="noopener noreferrer" class="hover:text-skin-accent">X</a>
            <a href={`https://www.linkedin.com/shareArticle?mini=true&url=${shareUrl}&title=${shareTitle}`} target="_blank" rel="noopener noreferrer" class="hover:text-skin-accent">LinkedIn</a>
            <a href={`https://api.whatsapp.com/send?text=${shareTitle}%20${shareUrl}`} target="_blank" rel="noopener noreferrer" class="hover:text-skin-accent">WhatsApp</a>
          </div>
        </div>

        <!-- AUTHOR BIO BOX -->
        <div class="my-8 flex items-center gap-4 rounded-xl border border-skin-line/60 bg-skin-card p-6">
          <div class="h-16 w-16 shrink-0 rounded-full bg-skin-accent/15 flex items-center justify-center font-bold text-xl text-skin-accent">
            {post.data.author ? post.data.author.charAt(0) : "A"}
          </div>
          <div>
            <h4 class="text-base font-bold text-skin-base">{post.data.author || "Editorial Staff"}</h4>
            <p class="mt-1 text-xs sm:text-sm text-skin-base/75 leading-relaxed">
              Specialized technical insights, off-grid system calibrations, and engineering guides for modern mobile setups.
            </p>
          </div>
        </div>

        <!-- RELATED ARTICLES -->
        {relatedPosts.length > 0 && (
          <div class="my-8 pt-6 border-t border-skin-line/60">
            <h3 class="text-lg font-bold text-skin-base mb-4">Related Articles</h3>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              {relatedPosts.map(rel => (
                <a href={`/posts/${getSlug(rel)}`} class="group flex gap-3 p-3 rounded-lg border border-skin-line/40 bg-skin-card hover:border-skin-accent transition-all">
                  <img src={getCover(rel)} alt={rel.data.title} class="h-16 w-16 object-cover rounded shrink-0" />
                  <div class="flex flex-col justify-center">
                    <h5 class="text-xs font-bold text-skin-base leading-snug line-clamp-2 group-hover:text-skin-accent">
                      {rel.data.title}
                    </h5>
                    <span class="mt-1 text-[10px] text-skin-base/60">
                      <Datetime pubDatetime={rel.data.pubDatetime} />
                    </span>
                  </div>
                </a>
              ))}
            </div>
          </div>
        )}

      </div>

      <!-- RIGHT SIDEBAR (1 COLUMN) -->
      <aside class="space-y-8">
        
        <!-- POPULAR POSTS -->
        <div class="rounded-2xl border border-skin-line/60 bg-skin-card p-5 shadow-xs">
          <h3 class="border-b border-skin-line/50 pb-3 font-bold text-sm uppercase tracking-wider text-skin-base flex items-center gap-2">
            <span class="h-2 w-2 rounded-full bg-skin-accent"></span>
            Popular Posts
          </h3>
          <div class="divide-y divide-skin-line/40 pt-2">
            {popularPosts.map((p, idx) => (
              <a href={`/posts/${getSlug(p)}`} class="group flex items-start gap-4 py-3.5 first:pt-3 last:pb-1">
                <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-slate-900 font-bold text-xs text-white">
                  {idx + 1}
                </span>
                <div class="flex flex-col">
                  <h4 class="text-xs sm:text-sm font-semibold text-skin-base leading-snug line-clamp-2 group-hover:text-skin-accent transition-colors">
                    {p.data.title}
                  </h4>
                  <span class="mt-1 text-[11px] text-skin-base/60">
                    <Datetime pubDatetime={p.data.pubDatetime} />
                  </span>
                </div>
              </a>
            ))}
          </div>
        </div>

      </aside>

    </div>
  </main>

  <Footer />
</Layout>
