---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Datetime from "@/components/Datetime.astro";

export interface Props {
  title?: string;
  author?: string;
  description?: string;
  ogImage?: any;
  canonicalURL?: string;
  pubDatetime?: Date;
  modDatetime?: Date | null;
  [key: string]: any;
}

const {
  title,
  author = "Amara Osei",
  description = "",
  ogImage,
  canonicalURL,
  pubDatetime,
  modDatetime,
} = Astro.props;

const allPosts = await getCollection("posts", ({ data }) => !data.draft);
const sortedPosts = allPosts.sort(
  (a, b) => b.data.pubDatetime.valueOf() - a.data.pubDatetime.valueOf()
);

const { slug } = Astro.params;
const post = allPosts.find(p => {
  const postSlug = (p.data as any).postSlug ?? p.id?.replace(/\.[^/.]+$/, "");
  return postSlug === slug || p.id === slug;
});

const getSlug = (p: any) => (p.data as any)?.postSlug ?? p.id?.replace(/\.[^/.]+$/, "");
const getCover = (p: any) =>
  p.data.ogImage && typeof p.data.ogImage === "string"
    ? p.data.ogImage
    : "/images/default-og.jpg";

const displayTitle = post?.data.title ?? (title ? title.split(" | ")[0] : "Technical Guide");
const displayAuthor = post?.data.author || author;
const displayCover = post?.data.ogImage && typeof post.data.ogImage === "string"
  ? post.data.ogImage
  : (typeof ogImage === "string" ? ogImage : "/images/default-og.jpg");

const tags = post?.data.tags || ["engineering"];
const primaryTag = tags[0] || "politics";

const validPubDatetime: Date = pubDatetime || post?.data.pubDatetime || new Date();
const validModDatetime = modDatetime ?? post?.data.modDatetime;

const wordCount = (post as any)?.body ? (post as any).body.split(/\s+/).length : 750;
const readingTime = `${Math.max(1, Math.ceil(wordCount / 200))} min read`;

// Kategori adetlerini dinamik hesaplama
const tagCounts = allPosts.reduce((acc: Record<string, number>, p) => {
  (p.data.tags || []).forEach((t: string) => {
    acc[t] = (acc[t] || 0) + 1;
  });
  return acc;
}, {});
const categories = Object.entries(tagCounts).slice(0, 8);
const allTags = Object.keys(tagCounts).slice(0, 15);

// Benzer ve popüler yazılar
const relatedPosts = sortedPosts
  .filter(p => (post ? p.id !== post.id : true) && p.data.tags?.some((t: string) => tags.includes(t)))
  .slice(0, 2);
const finalRelated = relatedPosts.length > 0 ? relatedPosts : sortedPosts.slice(0, 2);
const popularPosts = sortedPosts.slice(0, 5);

const currentUrl = Astro.url.href;
const shareUrl = encodeURIComponent(currentUrl);
const shareTitle = encodeURIComponent(displayTitle);
---

<Layout
  title={`${displayTitle} | Portal`}
  description={description || post?.data.description}
  ogImage={displayCover}
  canonicalURL={canonicalURL}
>
  <Header />

  <main class="text-slate-700">
    <div class="container xl:max-w-7xl mx-auto px-4 flex flex-col gap-4 lg:gap-6">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-4 lg:gap-6 py-6">
        
        <!-- LEFT POST CONTENT (2 COLS) -->
        <div class="lg:col-span-2 py-4">
          <h1 class="text-2xl md:text-3xl font-bold py-4 text-slate-900 leading-tight">
            {displayTitle}
          </h1>

          <!-- Meta Bar with Icons -->
          <div class="pb-4 w-full flex flex-wrap items-center gap-4 text-sm text-slate-500 border-b border-slate-200">
            <span class="flex items-center gap-1.5 hover:text-black">
              <svg width="1em" height="1em" class="size-3.5" viewBox="0 0 16 16" fill="currentColor">
                <path d="M8 8a3 3 0 1 0 0-6a3 3 0 0 0 0 6m2-3a2 2 0 1 1-4 0a2 2 0 0 1 4 0m4 8c0 1-1 1-1 1H3s-1 0-1-1s1-4 6-4s6 3 6 4m-1-.004c-.001-.246-.154-.986-.832-1.664C11.516 10.68 10.289 10 8 10s-3.516.68-4.168 1.332c-.678.678-.83 1.418-.832 1.664z"/>
              </svg>
              by {displayAuthor}
            </span>

            <span class="flex items-center gap-1.5">
              <svg width="1em" height="1em" class="size-3.5" viewBox="0 0 16 16" fill="currentColor">
                <path d="M3.5 0a.5.5 0 0 1 .5.5V1h8V.5a.5.5 0 0 1 1 0V1h1a2 2 0 0 1 2 2v11a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V3a2 2 0 0 1 2-2h1V.5a.5.5 0 0 1 .5-.5M1 4v10a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V4z"/>
              </svg>
              <Datetime pubDatetime={validPubDatetime} modDatetime={validModDatetime} />
            </span>

            <a href={`/tags/${primaryTag.toLowerCase()}`} class="flex items-center gap-1.5 hover:text-brand-600 capitalize">
              <svg width="1em" height="1em" class="size-3.5" viewBox="0 0 16 16" fill="currentColor">
                <path d="M2 2a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v13.5a.5.5 0 0 1-.777.416L8 13.101l-5.223 2.815A.5.5 0 0 1 2 15.5zm2-1a1 1 0 0 0-1 1v12.566l4.723-2.482a.5.5 0 0 1 .554 0L13 14.566V2a1 1 0 0 0-1-1z"/>
              </svg>
              {primaryTag}
            </a>

            <span class="flex items-center gap-1.5">
              <svg width="1em" height="1em" class="size-3.5" viewBox="0 0 16 16" fill="currentColor">
                <path d="M8 3.5a.5.5 0 0 0-1 0V9a.5.5 0 0 0 .252.434l3.5 2a.5.5 0 0 0 .496-.868L8 8.71z"/>
                <path d="M8 16A8 8 0 1 0 8 0a8 8 0 0 0 0 16m7-8A7 7 0 1 1 1 8a7 7 0 0 1 14 0"/>
              </svg>
              {readingTime}
            </span>
          </div>

          <!-- Cover Image (Aspect 2/1) -->
          <div class="aspect-[2/1] overflow-hidden w-full bg-slate-100 rounded-lg my-6">
            <img src={displayCover} alt={displayTitle} class="w-full h-full object-cover" />
          </div>

          <!-- Post Content -->
          <div class="relative post-content pt-2 prose prose-slate max-w-none dark:prose-invert prose-headings:font-heading prose-headings:font-bold prose-headings:text-slate-900 dark:prose-headings:text-white prose-p:text-slate-600 dark:prose-p:text-slate-300 prose-p:leading-relaxed prose-img:rounded-lg">
            <slot />
          </div>

          <!-- Tags + Share Bar -->
          <div class="flex flex-col sm:flex-row items-center justify-between gap-3 py-4 border-y border-slate-200 mt-8">
            <ul class="flex flex-wrap items-center gap-2 text-sm">
              <li>
                <svg width="1em" height="1em" class="size-4 text-slate-400" viewBox="0 0 16 16" fill="currentColor">
                  <path d="M3 2v4.586l7 7L14.586 9l-7-7zM2 2a1 1 0 0 1 1-1h4.586a1 1 0 0 1 .707.293l7 7a1 1 0 0 1 0 1.414l-4.586 4.586a1 1 0 0 1-1.414 0l-7-7A1 1 0 0 1 2 6.586z"/>
                </svg>
              </li>
              {tags.map((tag: string) => (
                <li>
                  <a href={`/tags/${tag.toLowerCase()}`} class="flex py-1 px-3 bg-white hover:bg-slate-100 rounded-sm border border-slate-200 capitalize">
                    {tag}
                  </a>
                </li>
              ))}
            </ul>

            <div class="flex items-center gap-1">
              <a href={`https://www.facebook.com/sharer/sharer.php?u=${shareUrl}`} aria-label="Share on Facebook" target="_blank" rel="noopener noreferrer" class="p-2 hover:opacity-70 transition-opacity">
                <svg width="1em" height="1em" class="size-4 text-slate-600" viewBox="0 0 16 16" fill="currentColor"><path d="M16 8.049c0-4.446-3.582-8.05-8-8.05C3.58 0-.002 3.603-.002 8.05c0 4.017 2.926 7.347 6.75 7.951v-5.625h-2.03V8.05H6.75V6.275c0-2.017 1.195-3.131 3.022-3.131c.876 0 1.791.157 1.791.157v1.98h-1.009c-.993 0-1.303.621-1.303 1.258v1.51h2.218l-.354 2.326H9.25V16c3.824-.604 6.75-3.934 6.75-7.951"/></svg>
              </a>
              <a href={`https://twitter.com/intent/tweet?url=${shareUrl}&text=${shareTitle}`} aria-label="Share on Twitter/X" target="_blank" rel="noopener noreferrer" class="p-2 hover:opacity-70 transition-opacity">
                <svg width="1em" height="1em" class="size-4 text-slate-600" viewBox="0 0 16 16" fill="currentColor"><path d="M12.6.75h2.454l-5.36 6.142L16 15.25h-4.937l-3.867-5.07l-4.425 5.07H.316l5.733-6.57L0 .75h5.063l3.495 4.633L12.601.75Zm-.86 13.028h1.36L4.323 2.145H2.865z"/></svg>
              </a>
              <a href={`https://www.linkedin.com/shareArticle?mini=true&url=${shareUrl}&title=${shareTitle}`} aria-label="Share on LinkedIn" target="_blank" rel="noopener noreferrer" class="p-2 hover:opacity-70 transition-opacity">
                <svg width="1em" height="1em" class="size-4 text-slate-600" viewBox="0 0 16 16" fill="currentColor"><path d="M0 1.146C0 .513.526 0 1.175 0h13.65C15.474 0 16 .513 16 1.146v13.708c0 .633-.526 1.146-1.175 1.146H1.175C.526 16 0 15.487 0 14.854zm4.943 12.248V6.169H2.542v7.225zm-1.2-8.212c.837 0 1.358-.554 1.358-1.248c-.015-.709-.52-1.248-1.342-1.248S2.4 3.226 2.4 3.934c0 .694.521 1.248 1.327 1.248zm4.908 8.212V9.359c0-.216.016-.432.08-.586c.173-.431.568-.878 1.232-.878c.869 0 1.216.662 1.216 1.634v3.865h2.401V9.25c0-2.22-1.184-3.252-2.764-3.252c-1.274 0-1.845.7-2.165 1.193v.025h-.016l.016-.025V6.169h-2.4c.03.678 0 7.225 0 7.225z"/></svg>
              </a>
              <a href={`https://api.whatsapp.com/send?text=${shareTitle}%20${shareUrl}`} aria-label="Share on WhatsApp" target="_blank" rel="noopener noreferrer" class="p-2 hover:opacity-70 transition-opacity">
                <svg width="1em" height="1em" class="size-4 text-slate-600" viewBox="0 0 16 16" fill="currentColor"><path d="M13.601 2.326A7.85 7.85 0 0 0 7.994 0C3.627 0 .068 3.558.064 7.926c0 1.399.366 2.76 1.057 3.965L0 16l4.204-1.102a7.9 7.9 0 0 0 3.79.965h.004c4.368 0 7.926-3.558 7.93-7.93A7.9 7.9 0 0 0 13.6 2.326z"/></svg>
              </a>
            </div>
          </div>

          <!-- Author Bio Card -->
          <div class="flex flex-row items-center py-6 md:py-8 border-b border-slate-200">
            <div class="shrink-0 rounded-full overflow-hidden size-20 bg-slate-900 text-white flex items-center justify-center font-bold text-2xl">
              {displayAuthor.charAt(0)}
            </div>
            <div class="ms-6">
              <h4 class="text-xl font-bold text-slate-900">{displayAuthor}</h4>
              <p class="text-sm text-slate-500 hover:text-black mt-0.5">Senior Technical Correspondent</p>
              <p class="hidden sm:block text-sm text-slate-500 mt-2 leading-relaxed">
                Specialized in off-grid mobile architectures, electrical engineering setups, dual-battery banks, and high-altitude climate systems.
              </p>
            </div>
          </div>

          <!-- Related Articles -->
          {finalRelated.length > 0 && (
            <div class="py-6 md:py-8 border-b border-slate-200">
              <h3 class="text-xl font-bold mb-2 text-slate-900">Related Article</h3>
              <div class="pt-2 flex flex-col">
                {finalRelated.map(item => (
                  <a href={`/posts/${getSlug(item)}`} class="flex gap-3 py-3 border-b last:border-b-0 border-slate-200 group">
                    <img src={getCover(item)} alt={item.data.title} class="size-16 object-cover rounded-sm shrink-0 bg-slate-100" />
                    <div class="flex flex-col gap-1">
                      <h4 class="capitalize font-bold text-sm text-slate-800 group-hover:text-brand-600 line-clamp-2">
                        {item.data.title}
                      </h4>
                      <span class="text-slate-400 text-xs">
                        <Datetime pubDatetime={item.data.pubDatetime} />
                      </span>
                    </div>
                  </a>
                ))}
              </div>
            </div>
          )}
        </div>

        <!-- RIGHT SIDEBAR (1 COL) -->
        <aside class="lg:col-span-1 lg:ps-6">
          <div class="flex flex-col gap-4 lg:gap-6 top-24 sticky">
            
            <!-- Category Widget -->
            <div class="bg-slate-50 border border-slate-200 rounded-lg">
              <h3 class="w-full px-6 py-3 border-b border-slate-200 font-bold text-slate-900 text-sm">
                Category
              </h3>
              <div class="py-3 px-6">
                <ul class="flex flex-col text-sm">
                  {categories.map(([catName, count]) => (
                    <li class="relative">
                      <a href={`/tags/${catName.toLowerCase()}`} class="flex items-center gap-3 justify-between py-1.5 hover:text-brand-600 transition-colors capitalize">
                        <span>{catName}</span>
                        <span class="text-slate-400">({count})</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            </div>

            <!-- Popular Post Widget -->
            <div class="bg-slate-50 border border-slate-200 rounded-lg">
              <h3 class="w-full px-6 py-3 border-b border-slate-200 font-bold text-slate-900 text-sm">
                Popular Post
              </h3>
              <div class="py-3 px-6 flex flex-col">
                {popularPosts.map(p => (
                  <a href={`/posts/${getSlug(p)}`} class="flex gap-3 py-3 border-b last:border-b-0 border-slate-200 group">
                    <img src={getCover(p)} alt={p.data.title} loading="lazy" class="bg-slate-100 size-16 object-cover rounded-sm shrink-0" />
                    <div class="flex flex-col gap-1">
                      <h4 class="text-sm font-medium capitalize group-hover:text-brand-600 line-clamp-2 text-slate-800">
                        {p.data.title}
                      </h4>
                      <span class="text-slate-400 text-xs">
                        <Datetime pubDatetime={p.data.pubDatetime} />
                      </span>
                    </div>
                  </a>
                ))}
              </div>
            </div>

            <!-- Tags Widget -->
            <div class="bg-slate-50 border border-slate-200 rounded-lg">
              <h3 class="w-full px-6 py-3 border-b border-slate-200 font-bold text-slate-900 text-sm">
                Tags
              </h3>
              <div class="p-6">
                <ul class="flex flex-wrap items-center gap-2 text-sm">
                  {allTags.map(tag => (
                    <li>
                      <a href={`/tags/${tag.toLowerCase()}`} class="flex py-1 px-3 rounded-sm bg-white hover:bg-slate-100 border border-slate-200 hover:text-black capitalize text-xs">
                        {tag}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            </div>

          </div>
        </aside>

      </div>
    </div>
  </main>

  <Footer />
</Layout>
