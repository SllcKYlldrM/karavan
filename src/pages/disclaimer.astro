---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Main from "@/components/Main.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Footer from "@/components/Footer.astro";
---

<Layout title="Engineering Disclaimer | VanSpecs" description="Important limitations for VanSpecs technical articles and engineering calculators.">
  <Header />
  <Breadcrumb />
  <Main pageTitle="Engineering Disclaimer" pageDesc="Important limitations for articles, formulas and browser-based calculators.">
    <div class="app-prose max-w-3xl space-y-8 text-base leading-8">
      <section>
        <h2>Planning information only</h2>
        <p>VanSpecs articles and calculators provide educational and early-stage planning information. They are not a substitute for a site-specific engineering design, permit, certification, inspection, commissioning test or professional advice.</p>
      </section>
      <section>
        <h2>Verify before installation</h2>
        <p>Use the exact current manufacturer datasheet, installation manual and rating label for every component. Verify voltage, current, temperature, environmental exposure, protection, wiring method, structural loads, ventilation, drainage and emergency provisions.</p>
        <p>Marine, gas, high-voltage AC, lithium battery, structural, fire and potable-water work must be reviewed and installed in accordance with applicable local requirements by qualified professionals.</p>
      </section>
      <section>
        <h2>Inputs and assumptions</h2>
        <p>Results depend on the values entered by the user and on simplified assumptions. A result that appears within a range is not a safety approval, and a result near a limit requires additional margin and verification.</p>
      </section>
      <section>
        <h2>No guarantee</h2>
        <p>VanSpecs Technical Team makes no guarantee that an article or calculation is complete, current or suitable for a specific vehicle, vessel, building, installation or jurisdiction. Use the information at your own risk and obtain professional confirmation for decisions that affect safety, property or compliance.</p>
      </section>
    </div>
  </Main>
  <Footer />
</Layout>
