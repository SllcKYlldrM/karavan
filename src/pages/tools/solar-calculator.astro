---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import SolarCalculator from "@/components/calculator/SolarCalculator.astro";

const toolUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;
const homeUrl = new URL("/", Astro.site ?? Astro.url).href;
const toolSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: "VanSpecs Solar, Battery and Cable Calculator",
  applicationCategory: "UtilitiesApplication",
  operatingSystem: "Web",
  url: toolUrl,
  description: "Estimate RV solar panel power, battery capacity and DC cable size for an off-grid system.",
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  featureList: ["Daily energy estimate", "Battery capacity estimate", "Solar panel sizing", "DC cable sizing"],
});
const breadcrumbSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: homeUrl },
    { "@type": "ListItem", position: 2, name: "Tools", item: toolUrl },
  ],
});
---

<Layout
  title="Solar & Battery Calculator | VanSpecs"
  description="Estimate RV solar panel power, battery capacity and DC cable size for an off-grid system."
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={toolSchema}></script>
    <script is:inline type="application/ld+json" set:html={breadcrumbSchema}></script>
  </Fragment>
  <Header />
  <main id="main-content" class="mx-auto w-full max-w-[1480px] px-6 py-10 sm:px-10 lg:px-12">
    <div class="mx-auto max-w-5xl">
      <nav class="mb-6 text-sm text-skin-base/65" aria-label="Breadcrumb">
        <a href="/" class="hover:text-skin-accent">Home</a>
        <span class="mx-2" aria-hidden="true">/</span>
        <span>Tools</span>
      </nav>
      <SolarCalculator />
      <p class="mx-auto mt-6 max-w-3xl text-center text-xs leading-5 text-skin-base/60">
        Results are planning estimates, not a substitute for a qualified electrical design or the manufacturer’s installation instructions.
      </p>
    </div>
  </main>
  <Footer />
</Layout>
