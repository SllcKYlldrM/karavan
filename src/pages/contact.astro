---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Main from "@/components/Main.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Footer from "@/components/Footer.astro";
---

<Layout title="Contact VanSpecs" description="Send corrections, source updates or technical feedback to VanSpecs.">
  <Header />
  <Breadcrumb />
  <Main pageTitle="Contact" pageDesc="Send corrections, source updates or technical feedback about VanSpecs content.">
    <div class="app-prose max-w-3xl space-y-8 text-base leading-8">
      <section>
        <h2>Send a message</h2>
        <p>If you find an incorrect calculation, outdated specification or broken link, include the affected page, the input values and the source that supports the correction.</p>
        <form id="contact-form" class="not-prose mt-6 space-y-5" method="post" action="/api/contact">
          <div>
            <label for="name" class="mb-2 block font-semibold">Name</label>
            <input id="name" name="name" type="text" autocomplete="name" required maxlength="100" class="w-full rounded-lg border border-border bg-background px-3 py-2 text-foreground" />
          </div>
          <div>
            <label for="email" class="mb-2 block font-semibold">Email</label>
            <input id="email" name="email" type="email" autocomplete="email" required maxlength="254" class="w-full rounded-lg border border-border bg-background px-3 py-2 text-foreground" />
          </div>
          <div>
            <label for="subject" class="mb-2 block font-semibold">Subject</label>
            <input id="subject" name="subject" type="text" maxlength="160" class="w-full rounded-lg border border-border bg-background px-3 py-2 text-foreground" />
          </div>
          <div>
            <label for="message" class="mb-2 block font-semibold">Message</label>
            <textarea id="message" name="message" rows="7" required minlength="20" maxlength="5000" class="w-full rounded-lg border border-border bg-background px-3 py-2 text-foreground"></textarea>
          </div>
          <div class="hidden" aria-hidden="true">
            <label for="website">Website</label>
            <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
          </div>
          <div class="cf-turnstile" data-sitekey={import.meta.env.PUBLIC_TURNSTILE_SITE_KEY}></div>
          <button type="submit" class="rounded-lg bg-accent px-5 py-2.5 font-semibold text-accent-foreground transition-opacity hover:opacity-85">Send message</button>
          <p id="contact-status" class="min-h-6" role="status" aria-live="polite"></p>
        </form>
      </section>
      <section>
        <h2>Technical feedback</h2>
        <p>Useful reports include reproducible steps, manufacturer documentation, applicable standards and the date of the information. Do not share private credentials, API keys or unnecessary personal data.</p>
      </section>
      <section>
        <h2>Safety reports</h2>
        <p>For an immediate safety concern, stop using the affected result and consult a qualified professional. This website is not an emergency or inspection service.</p>
      </section>
    </div>
  </Main>
  <Footer />
</Layout>

<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
<script>
  const form = document.querySelector<HTMLFormElement>("#contact-form");
  const status = document.querySelector<HTMLElement>("#contact-status");

  form?.addEventListener("submit", async event => {
    event.preventDefault();
    if (!status) return;
    status.textContent = "Sending…";
    status.className = "min-h-6 text-skin-base/70";

    try {
      const response = await fetch(form.action, {
        method: "POST",
        body: new FormData(form),
        headers: { Accept: "application/json" },
      });
      const result = (await response.json()) as { message?: string };
      if (!response.ok) throw new Error(result.message ?? "The message could not be sent.");
      form.reset();
      status.textContent = result.message ?? "Your message has been sent.";
      status.className = "min-h-6 text-emerald-600 dark:text-emerald-400";
    } catch (error) {
      status.textContent = error instanceof Error ? error.message : "The message could not be sent.";
      status.className = "min-h-6 text-red-600 dark:text-red-400";
    }
  });
</script>
