---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Main from "@/components/Main.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Card from "@/components/Card.astro";
import Footer from "@/components/Footer.astro";
import { contentScopes } from "@/data/category-tree";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { slugifyStr } from "@/utils/slugify";
import config from "@/config";

export function getStaticPaths() {
  return contentScopes.map(scope => ({ params: { scope: scope.slug }, props: { scope } }));
}

const { scope } = Astro.props;
const posts = await getCollection("posts", ({ data }) => !data.draft && (data.scope ?? "caravan") === scope.id);
const sortedPosts = getSortedPosts(posts);
const legacyCategoryNames: Record<string, string[]> = {
  "Power & Solar": ["Power & Solar Systems"],
  "Water & Plumbing": ["Water & Plumbing Systems"],
  "HVAC & Heating": ["HVAC & Climate Control"],
  "Smart RV & IoT": ["Smart RV & IoT"],
  "Towing & Weight": [],
  "Electrical & Wiring": [],
};
const groups = scope.groups.map(group => ({
  ...group,
  count: sortedPosts.filter(post =>
    post.data.category === group.name ||
    legacyCategoryNames[group.name]?.includes(post.data.category ?? "") ||
    (post.data.category === "Engineering Calculators" && group.name === "Towing & Weight" && ["towing-safety", "weight-sizing"].includes(post.data.calculator ?? "")) ||
    (post.data.category === "Engineering Calculators" && group.name === "Electrical & Wiring" && post.data.calculator === "cable-sizing") ||
    (post.data.subcategory && group.children.includes(post.data.subcategory))
  ).length,
}));
---

<Layout title={`${scope.name} | ${config.site.title}`}>
  <Header />
  <Breadcrumb />
  <Main pageTitle={scope.name} pageDesc={`Technical guides and planning tools for ${scope.name.toLowerCase()}.`}>
    <div class="mb-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {groups.map(group => (
        <div class="rounded-xl border border-skin-line bg-skin-card p-4 shadow-sm">
          <h2 class="font-bold text-skin-base">{group.name}</h2>
          <p class="mt-1 text-xs text-skin-base/65">{group.count} published guide{group.count === 1 ? "" : "s"}</p>
          <ul class="mt-3 flex flex-wrap gap-2">
            {group.children.map(child => (
              <li>
                <a
                  href={`/scopes/${scope.slug}/${slugifyStr(child)}`}
                  class="inline-flex rounded-md border border-skin-line px-2.5 py-1 text-xs text-skin-accent transition-colors hover:border-skin-accent hover:bg-skin-card-muted"
                >
                  {child}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
    {sortedPosts.length > 0 ? (
      <ul>{sortedPosts.map(data => <Card {...data} />)}</ul>
    ) : (
      <p class="rounded-xl border border-dashed border-skin-line p-6 text-skin-base/70">Guides for this scope are being prepared.</p>
    )}
  </Main>
  <Footer />
</Layout>
---
