---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import LinkButton from "@/components/LinkButton.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { posts: postsConfig } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
const homePath = getRelativeLocaleUrl(locale, "");
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout my-1"
  >
    <!-- Hero / Karşılama Alanı -->
    <section id="hero" class="py-8 border-b border-skin-line/50 mb-8">
      <h1 class="text-3xl font-bold tracking-tight sm:text-4xl text-skin-accent">
        Caravan Tools & Calculators
      </h1>
      <p class="mt-3 text-base leading-relaxed text-skin-base opacity-90 max-w-2xl">
        Essential towing calculators, weight ratio guides, and advanced engineering tools for smart off-grid caravaners.
      </p>
    </section>

    <!-- Öne Çıkan Yazılar (Büyük Grid) -->
    {
      featuredPosts.length > 0 && (
        <section id="featured" class="mb-10">
          <h2 class="text-2xl font-semibold tracking-wide mb-6 flex items-center gap-2">
            <span class="w-2 h-6 bg-skin-accent rounded-full inline-block"></span>
            {t.home.featured}
          </h2>
          <ul class="grid grid-cols-1 md:grid-cols-2 gap-6">
            {featuredPosts.map(data => (
              <li class="bg-skin-card/50 border border-skin-line/60 rounded-xl p-4 transition-all hover:border-skin-accent">
                <Card variant="h3" {...data} />
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <!-- Son Eklenen Yazılar (Portal / Dergi Grid Yapısı) -->
    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="mb-10">
          <h2 class="text-2xl font-semibold tracking-wide mb-6 flex items-center gap-2">
            <span class="w-2 h-6 bg-skin-accent rounded-full inline-block"></span>
            {t.home.recentPosts}
          </h2>
          <ul class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {recentPosts.slice(0, postsConfig.perIndex).map(data => (
              <li class="bg-skin-card/50 border border-skin-line/60 rounded-xl p-4 transition-all hover:border-skin-accent flex flex-col justify-between">
                <Card variant="h3" {...data} />
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <!-- Tüm Yazılara Git Butonu -->
    <div class="my-10 text-center">
      <LinkButton 
        href={getRelativeLocaleUrl(locale, "posts")}
        class="px-6 py-3 border border-skin-accent text-skin-accent rounded-lg hover:bg-skin-accent hover:text-skin-inverted transition-colors font-medium inline-flex items-center gap-2"
      >
        {t.home.allPosts}
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
