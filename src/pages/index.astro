---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Datetime from "@/components/Datetime.astro";
import HeroSlider from "@/components/HeroSlider.astro";
import { slugifyStr } from "@/utils/slugify";

// 1. Yazıları getir ve tarihe göre sırala
const allPosts = await getCollection("posts", ({ data }) => !data.draft);
const sortedPosts = allPosts.sort(
  (a, b) => b.data.pubDatetime.valueOf() - a.data.pubDatetime.valueOf()
);

// Tip Güvenli Slug ve Görsel Yardımcıları
const getSlug = (post: any) => post.data.postSlug ?? post.id?.replace(/\.[^/.]+$/, "");
const getCover = (post: any) =>
  post.data.ogImage && typeof post.data.ogImage === "string"
    ? post.data.ogImage
    : "/images/default-og.jpg";

// Düzen için yazı grupları
const heroPosts = sortedPosts.slice(0, 3);
const heroPost = heroPosts[0];
const subGridPosts = sortedPosts.slice(3, 6);
const leadSectionPost = sortedPosts[6] || sortedPosts[0];
const leadSectionList = sortedPosts.slice(7, 10);
const trendingPosts = sortedPosts.slice(0, 4);

// Benzersiz etiketler (Sidebar için)
const allTags = [...new Set(sortedPosts.flatMap(p => p.data.tags || []))].slice(0, 12);
---

<Layout>
  <Header activeNav="home" />

  <main id="main-content" class="mx-auto max-w-[1480px] px-6 py-6 sm:px-10 lg:px-12">
    
    <!-- 1. MANŞET (HERO BANNER) -->
    {heroPost && (
      <section class="mb-10">
        <HeroSlider posts={heroPosts} />
        <div class="hidden group relative aspect-[16/9] sm:aspect-[21/9] w-full overflow-hidden rounded-2xl border border-skin-line/50 bg-skin-card shadow-sm">
          <img
            src={getCover(heroPost)}
            alt={heroPost.data.title}
            class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/45 to-transparent"></div>
          
          <div class="absolute bottom-0 left-0 right-0 p-6 sm:p-10">
            {heroPost.data.tags?.[0] && (
              <span class="inline-block rounded-md bg-skin-accent px-3 py-1 text-xs font-bold uppercase tracking-wider text-white shadow-sm">
                {heroPost.data.tags[0]}
              </span>
            )}
            <h1 class="mt-3 font-bold text-white text-xl sm:text-3xl lg:text-4xl leading-tight max-w-3xl drop-shadow-sm">
              <a href={`/posts/${getSlug(heroPost)}`} class="hover:underline">
                {heroPost.data.title}
              </a>
            </h1>
            <p class="mt-2 text-xs sm:text-sm text-slate-300 line-clamp-2 max-w-2xl leading-relaxed">
              {heroPost.data.description}
            </p>
            <div class="mt-4 flex items-center gap-3 text-xs text-slate-400 font-medium">
              <span>{heroPost.data.author || "Editorial"}</span>
              <span>•</span>
              <Datetime pubDatetime={heroPost.data.pubDatetime} modDatetime={heroPost.data.modDatetime} />
            </div>
          </div>
        </div>
      </section>
    )}

    <!-- 2. ANA GÖVDE (SOL AKIŞ + SAĞ SİDEBAR) -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      
      <!-- SOL AKIŞ (2 SÜTUN) -->
      <div class="lg:col-span-2 space-y-12">
        
        <!-- BÖLÜM A: 3'LÜ KART IZGARASI -->
        {subGridPosts.length > 0 && (
          <section>
            <div class="flex items-center justify-between border-b border-skin-line/60 pb-3 mb-6">
              <h2 class="border-s-4 border-skin-accent ps-3 text-base sm:text-lg font-bold tracking-wide text-skin-base uppercase">
                Technical Reviews
              </h2>
              <a href="/posts" class="text-xs font-semibold text-skin-accent hover:underline">
                View All &rarr;
              </a>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-5">
              {subGridPosts.map(post => (
                <article class="group flex flex-col overflow-hidden rounded-xl border border-skin-line/50 bg-skin-card transition-all duration-300 hover:border-skin-accent hover:shadow-md">
                  <a href={`/posts/${getSlug(post)}`} class="relative aspect-[16/10] w-full overflow-hidden bg-skin-card-muted">
                    <img
                      src={getCover(post)}
                      alt={post.data.title}
                      loading="lazy"
                      class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                    />
                    {post.data.tags?.[0] && (
                      <span class="absolute top-2.5 left-2.5 rounded bg-black/75 px-2 py-0.5 text-[10px] font-semibold text-white">
                        {post.data.tags[0]}
                      </span>
                    )}
                  </a>
                  <div class="flex flex-1 flex-col justify-between p-4">
                    <h3 class="font-bold text-sm text-skin-base leading-snug line-clamp-2 group-hover:text-skin-accent transition-colors">
                      <a href={`/posts/${getSlug(post)}`}>{post.data.title}</a>
                    </h3>
                    <div class="mt-3 text-[11px] text-skin-base/60">
                      <Datetime pubDatetime={post.data.pubDatetime} />
                    </div>
                  </div>
                </article>
              ))}
            </div>
          </section>
        )}

        <!-- BÖLÜM B: LİDER HABER + YATAY LİSTE -->
        {leadSectionPost && (
          <section>
            <div class="flex items-center justify-between border-b border-skin-line/60 pb-3 mb-6">
              <h2 class="border-s-4 border-skin-accent ps-3 text-base sm:text-lg font-bold tracking-wide text-skin-base uppercase">
                Engineering Guides
              </h2>
            </div>

            <div class="space-y-6">
              <!-- Büyük Odak Kartı -->
              <article class="grid grid-cols-1 sm:grid-cols-[280px_1fr] gap-5 pb-6 border-b border-skin-line/40 group">
                <a href={`/posts/${getSlug(leadSectionPost)}`} class="relative aspect-[16/10] overflow-hidden rounded-xl bg-skin-card-muted">
                  <img
                    src={getCover(leadSectionPost)}
                    alt={leadSectionPost.data.title}
                    loading="lazy"
                    class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                  />
                </a>
                <div class="flex flex-col justify-center">
                  {leadSectionPost.data.tags?.[0] && (
                    <span class="text-xs font-bold uppercase text-skin-accent tracking-wide">
                      {leadSectionPost.data.tags[0]}
                    </span>
                  )}
                  <h3 class="mt-2 text-lg font-bold text-skin-base leading-snug group-hover:text-skin-accent transition-colors">
                    <a href={`/posts/${getSlug(leadSectionPost)}`}>{leadSectionPost.data.title}</a>
                  </h3>
                  <p class="mt-2 text-sm text-skin-base/75 leading-relaxed line-clamp-2">
                    {leadSectionPost.data.description}
                  </p>
                  <div class="mt-3 text-xs text-skin-base/60">
                    <Datetime pubDatetime={leadSectionPost.data.pubDatetime} />
                  </div>
                </div>
              </article>

              <!-- Kompakt Sıralı Kartlar -->
              {leadSectionList.map(post => (
                <article class="grid grid-cols-[110px_1fr] sm:grid-cols-[140px_1fr] gap-4 py-3 border-b border-skin-line/30 last:border-b-0 group">
                  <a href={`/posts/${getSlug(post)}`} class="relative aspect-[16/10] overflow-hidden rounded-lg bg-skin-card-muted">
                    <img
                      src={getCover(post)}
                      alt={post.data.title}
                      loading="lazy"
                      class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                    />
                  </a>
                  <div class="flex flex-col justify-center">
                    <h4 class="text-sm font-bold text-skin-base leading-snug line-clamp-2 group-hover:text-skin-accent transition-colors">
                      <a href={`/posts/${getSlug(post)}`}>{post.data.title}</a>
                    </h4>
                    <p class="mt-1 text-xs text-skin-base/70 line-clamp-1 hidden sm:block">
                      {post.data.description}
                    </p>
                    <div class="mt-1.5 text-[11px] text-skin-base/60">
                      <Datetime pubDatetime={post.data.pubDatetime} />
                    </div>
                  </div>
                </article>
              ))}
            </div>
          </section>
        )}

      </div>

      <!-- SAĞ SİDEBAR (1 SÜTUN) -->
      <aside class="space-y-8">
        
        <!-- SİDEBAR 1: NUMARALI TRENDLER -->
        <div class="rounded-2xl border border-skin-line/60 bg-skin-card p-5 shadow-xs">
          <h3 class="border-b border-skin-line/50 pb-3 font-bold text-sm uppercase tracking-wider text-skin-base flex items-center gap-2">
            <span class="inline-block h-2 w-2 rounded-full bg-skin-accent"></span>
            Popular Topics
          </h3>
          <div class="divide-y divide-skin-line/40 pt-2">
            {trendingPosts.map((post, idx) => (
              <a href={`/posts/${getSlug(post)}`} class="group flex items-start gap-4 py-3.5 first:pt-3 last:pb-1">
                <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-skin-fill border border-skin-line font-bold text-xs text-skin-accent shadow-xs group-hover:bg-skin-accent group-hover:text-white transition-colors">
                  {idx + 1}
                </span>
                <div class="flex flex-col">
                  <h4 class="text-xs sm:text-sm font-semibold text-skin-base leading-snug line-clamp-2 group-hover:text-skin-accent transition-colors">
                    {post.data.title}
                  </h4>
                  <span class="mt-1 text-[11px] text-skin-base/60">
                    <Datetime pubDatetime={post.data.pubDatetime} />
                  </span>
                </div>
              </a>
            ))}
          </div>
        </div>

        <!-- SİDEBAR 2: KATEGORİ VE ETİKET BULUTU -->
        {allTags.length > 0 && (
          <div class="rounded-2xl border border-skin-line/60 bg-skin-card p-5 shadow-xs">
            <h3 class="border-b border-skin-line/50 pb-3 font-bold text-sm uppercase tracking-wider text-skin-base flex items-center gap-2">
              <span class="inline-block h-2 w-2 rounded-full bg-skin-accent"></span>
              Tags & Categories
            </h3>
            <div class="flex flex-wrap gap-2 pt-4">
              {allTags.map(tag => (
                <a
                  href={`/tags/${slugifyStr(tag)}`}
                  class="rounded-md border border-skin-line/70 bg-skin-fill px-2.5 py-1 text-xs font-medium text-skin-base transition-all hover:border-skin-accent hover:text-skin-accent"
                >
                  #{tag}
                </a>
              ))}
            </div>
          </div>
        )}

        <!-- SİDEBAR 3: PORTAL HAKKINDA KUTUSU -->
        <div class="rounded-2xl border border-skin-line/60 bg-skin-card p-6 shadow-xs text-center">
          <div class="mx-auto mb-3 flex h-10 w-10 items-center justify-center rounded-full bg-skin-accent/10 text-skin-accent">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </div>
          <h4 class="font-bold text-skin-base text-base">Caravan & Off-Grid Engineering</h4>
          <p class="mt-2 text-xs text-skin-base/75 leading-relaxed">
            Guides covering 12V electrical systems, LiFePO4 battery management, and water system optimization.
          </p>
          <a
            href="/posts"
            class="mt-4 inline-block w-full rounded-lg bg-skin-accent px-4 py-2.5 text-xs font-bold text-white shadow-sm transition-opacity hover:opacity-90"
          >
            View All Articles &rarr;
          </a>
        </div>

      </aside>

    </div>

  </main>

  <Footer />
</Layout>
